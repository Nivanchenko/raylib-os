Перем Гравитация Экспорт;
Перем Объекты Экспорт; // Массив из Кубик

Процедура ПриСозданииОбъекта()
	Гравитация = Новый Вектор(0, 9.81);
	Объекты = Новый Массив;
КонецПроцедуры

Процедура Шаг(Размер) Экспорт
	Для каждого Объект Из Объекты Цикл
		Объект.Направление = Объект.Направление.Сложить(Гравитация.Умножить(Размер));
	КонецЦикла;

	Для каждого Объект Из Объекты Цикл
		Объект.Шаг(Размер);
	КонецЦикла;
КонецПроцедуры