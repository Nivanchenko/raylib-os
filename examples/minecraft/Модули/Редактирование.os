Функция НовыйРезультат(Изменено, Причина)
    Возврат Новый Структура("Изменено,Причина", Изменено, Причина);
КонецФункции

Функция ЦелоеЧисло(Значение)
    Возврат Значение = Цел(Значение);
КонецФункции

Функция АбсолютноеЗначение(Значение)
    Возврат Макс(Значение, -Значение);
КонецФункции

Функция ПроверитьЦель(Мир, Выбор)
    Если Не Выбор.Попадание Тогда
        Возврат "no-hit";
    КонецЕсли;

    Если Выбор.Расстояние < 0 Или Выбор.Расстояние > 5 + 0.000000001 Тогда
        Возврат "no-hit";
    КонецЕсли;

    Если Не Мир.ВГраницах(Выбор.X, Выбор.Y, Выбор.Z) Тогда
        Возврат "no-hit";
    КонецЕсли;

    Если Мир.ПолучитьБлок(Выбор.X, Выбор.Y, Выбор.Z) = 0 Тогда
        Возврат "no-hit";
    КонецЕсли;

    Возврат "";
КонецФункции

Функция ПересекаетКубБезопасности(Цель, ПозицияИгрока)
    Эпсилон = 0.000000001;

    ПересекаетсяX = Цель.X < ПозицияИгрока.X + 0.2 - Эпсилон
        И Цель.X + 1 > ПозицияИгрока.X - 0.2 + Эпсилон;
    ПересекаетсяY = Цель.Y < ПозицияИгрока.Y + 0.2 - Эпсилон
        И Цель.Y + 1 > ПозицияИгрока.Y - 0.2 + Эпсилон;
    ПересекаетсяZ = Цель.Z < ПозицияИгрока.Z + 0.2 - Эпсилон
        И Цель.Z + 1 > ПозицияИгрока.Z - 0.2 + Эпсилон;

    Возврат ПересекаетсяX И ПересекаетсяY И ПересекаетсяZ;
КонецФункции

Функция Удалить(Мир, Выбор) Экспорт
    Причина = ПроверитьЦель(Мир, Выбор);
    Если Причина <> "" Тогда
        Возврат НовыйРезультат(Ложь, Причина);
    КонецЕсли;

    Если Мир.УстановитьБлок(Выбор.X, Выбор.Y, Выбор.Z, 0) Тогда
        Возврат НовыйРезультат(Истина, "ok");
    КонецЕсли;

    Возврат НовыйРезультат(Ложь, "no-hit");
КонецФункции

Функция Поставить(Мир, Выбор, Тип, ПозицияИгрока) Экспорт
    Причина = ПроверитьЦель(Мир, Выбор);
    Если Причина <> "" Тогда
        Возврат НовыйРезультат(Ложь, Причина);
    КонецЕсли;

    Если Не ЦелоеЧисло(Тип) Или Тип < 1 Или Тип > 3 Тогда
        Возврат НовыйРезультат(Ложь, "invalid-type");
    КонецЕсли;

    Если Не ЦелоеЧисло(Выбор.NX)
        Или Не ЦелоеЧисло(Выбор.NY)
        Или Не ЦелоеЧисло(Выбор.NZ)
        Или АбсолютноеЗначение(Выбор.NX)
            + АбсолютноеЗначение(Выбор.NY)
            + АбсолютноеЗначение(Выбор.NZ) <> 1 Тогда
        Возврат НовыйРезультат(Ложь, "invalid-hit");
    КонецЕсли;

    X = Выбор.X + Выбор.NX;
    Y = Выбор.Y + Выбор.NY;
    Z = Выбор.Z + Выбор.NZ;
    Если Не Мир.ВГраницах(X, Y, Z) Тогда
        Возврат НовыйРезультат(Ложь, "bounds");
    КонецЕсли;

    Если Мир.ПолучитьБлок(X, Y, Z) <> 0 Тогда
        Возврат НовыйРезультат(Ложь, "occupied");
    КонецЕсли;

    Цель = Новый Структура("X,Y,Z", X, Y, Z);
    Если ПересекаетКубБезопасности(Цель, ПозицияИгрока) Тогда
        Возврат НовыйРезультат(Ложь, "near-camera");
    КонецЕсли;

    Если Мир.УстановитьБлок(X, Y, Z, Тип) Тогда
        Возврат НовыйРезультат(Истина, "ok");
    КонецЕсли;

    Возврат НовыйРезультат(Ложь, "occupied");
КонецФункции
