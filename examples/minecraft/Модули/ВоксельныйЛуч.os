Функция Промах()
    Возврат Новый Структура(
        "Попадание,X,Y,Z,NX,NY,NZ,Расстояние",
        Ложь, 0, 0, 0, 0, 0, 0, 0);
КонецФункции

Функция Пол(Значение)
    ЦелаяЧасть = Цел(Значение);
    Если Значение < ЦелаяЧасть Тогда
        Возврат ЦелаяЧасть - 1;
    КонецЕсли;
    Возврат ЦелаяЧасть;
КонецФункции

Функция Знак(Значение)
    Если Значение > 0 Тогда
        Возврат 1;
    КонецЕсли;
    Возврат -1;
КонецФункции

Функция НормальНулевая(Нормаль)
    Возврат Нормаль.Получить(0) = 0
        И Нормаль.Получить(1) = 0
        И Нормаль.Получить(2) = 0;
КонецФункции

Функция СоздатьПопадание(X, Y, Z, Нормаль, Расстояние)
    Возврат Новый Структура(
        "Попадание,X,Y,Z,NX,NY,NZ,Расстояние",
        Истина,
        X, Y, Z,
        Нормаль.Получить(0),
        Нормаль.Получить(1),
        Нормаль.Получить(2),
        Расстояние);
КонецФункции

Функция Трассировать(Мир, Начало, Направление, Дальность = 5) Экспорт
    Эпсилон = 0.000000001;
    ЭпсилонСтарта = 0.000001;
    Бесконечность = 1000000000000000000;
    ПределНулевогоНаправления = 0.000000000001;

    P = Новый Массив;
    P.Добавить(Начало.X);
    P.Добавить(Начало.Y);
    P.Добавить(Начало.Z);

    D = Новый Массив;
    D.Добавить(Направление.X);
    D.Добавить(Направление.Y);
    D.Добавить(Направление.Z);

    Размеры = Новый Массив;
    Размеры.Добавить(16);
    Размеры.Добавить(8);
    Размеры.Добавить(16);

    ДлинаНаправления = Sqrt(
        D.Получить(0) * D.Получить(0)
        + D.Получить(1) * D.Получить(1)
        + D.Получить(2) * D.Получить(2));
    Если Дальность <= 0 Или ДлинаНаправления < ПределНулевогоНаправления Тогда
        Возврат Промах();
    КонецЕсли;

    Для Ось = 0 По 2 Цикл
        D.Установить(Ось, D.Получить(Ось) / ДлинаНаправления);
    КонецЦикла;

    // Камера внутри занятой клетки не может выбрать цель.
    Если Мир.ПолучитьБлок(Пол(P.Получить(0)), Пол(P.Получить(1)), Пол(P.Получить(2))) <> 0 Тогда
        Возврат Промах();
    КонецЕсли;

    Шаг = Новый Массив;
    Ячейка = Новый Массив;
    МаксимумПересечения = Новый Массив;
    ДельтаПересечения = Новый Массив;
    НормальВхода = Новый Массив;
    Для Ось = 0 По 2 Цикл
        Шаг.Добавить(0);
        Ячейка.Добавить(0);
        МаксимумПересечения.Добавить(Бесконечность);
        ДельтаПересечения.Добавить(Бесконечность);
        НормальВхода.Добавить(0);
    КонецЦикла;

    ВремяВхода = -Бесконечность;
    ВремяВыхода = Бесконечность;
    Для Ось = 0 По 2 Цикл
        НачальнаяКоордината = P.Получить(Ось);
        КомпонентаНаправления = D.Получить(Ось);
        РазмерОси = Размеры.Получить(Ось);

        Если Макс(КомпонентаНаправления, -КомпонентаНаправления) < ПределНулевогоНаправления Тогда
            Если НачальнаяКоордината < 0 Или НачальнаяКоордината >= РазмерОси Тогда
                Возврат Промах();
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        ВремяДоМинимальнойГрани = (0 - НачальнаяКоордината) / КомпонентаНаправления;
        ВремяДоМаксимальнойГрани = (РазмерОси - НачальнаяКоордината) / КомпонентаНаправления;
        ВремяБлижнейГрани = Мин(ВремяДоМинимальнойГрани, ВремяДоМаксимальнойГрани);
        ВремяДальнейГрани = Макс(ВремяДоМинимальнойГрани, ВремяДоМаксимальнойГрани);

        Если ВремяБлижнейГрани > ВремяВхода + Эпсилон Тогда
            ВремяВхода = ВремяБлижнейГрани;
            Для ИндексНормали = 0 По 2 Цикл
                НормальВхода.Установить(ИндексНормали, 0);
            КонецЦикла;
            НормальВхода.Установить(Ось, -Знак(КомпонентаНаправления));
        КонецЕсли;

        Если ВремяДальнейГрани < ВремяВыхода Тогда
            ВремяВыхода = ВремяДальнейГрани;
        КонецЕсли;
    КонецЦикла;

    ВремяСтарта = Макс(0, ВремяВхода);
    ВремяКонца = Мин(Дальность, ВремяВыхода);
    Если ВремяСтарта > ВремяКонца + Эпсилон Или ВремяВыхода < 0 Тогда
        Возврат Промах();
    КонецЕсли;

    ИсходнаяЯчейка = Новый Массив;
    Для Ось = 0 По 2 Цикл
        Координата = P.Получить(Ось)
            + D.Получить(Ось) * (ВремяСтарта + ЭпсилонСтарта);
        НачальнаяЯчейка = Пол(P.Получить(Ось));
        Ячейка.Установить(Ось, Пол(Координата));
        ИсходнаяЯчейка.Добавить(НачальнаяЯчейка);
    КонецЦикла;

    Для Ось = 0 По 2 Цикл
        Если Ячейка.Получить(Ось) < 0 Или Ячейка.Получить(Ось) >= Размеры.Получить(Ось) Тогда
            Возврат Промах();
        КонецЕсли;
    КонецЦикла;

    Нормаль = Новый Массив;
    Для Ось = 0 По 2 Цикл
        Если ВремяВхода >= 0 Тогда
            Нормаль.Добавить(НормальВхода.Получить(Ось));
        Иначе
            Нормаль.Добавить(0);
        КонецЕсли;
    КонецЦикла;

    // Если epsilon перенёс старт через целую границу, вернуть нормаль входа.
    Если ВремяСтарта = 0 И НормальНулевая(Нормаль) Тогда
        Для Ось = 0 По 2 Цикл
            Если Ячейка.Получить(Ось) <> ИсходнаяЯчейка.Получить(Ось) Тогда
                Нормаль.Установить(Ось, -Знак(D.Получить(Ось)));
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Расстояние = ВремяСтарта;
    Для Ось = 0 По 2 Цикл
        КомпонентаНаправления = D.Получить(Ось);
        Если Макс(КомпонентаНаправления, -КомпонентаНаправления) < ПределНулевогоНаправления Тогда
            Шаг.Установить(Ось, 0);
            МаксимумПересечения.Установить(Ось, Бесконечность);
            ДельтаПересечения.Установить(Ось, Бесконечность);
        Иначе
            НаправлениеОси = Знак(КомпонентаНаправления);
            Шаг.Установить(Ось, НаправлениеОси);
            Если НаправлениеОси > 0 Тогда
                СледующаяГраница = Ячейка.Получить(Ось) + 1;
            Иначе
                СледующаяГраница = Ячейка.Получить(Ось);
            КонецЕсли;
            МаксимумПересечения.Установить(
                Ось,
                (СледующаяГраница - P.Получить(Ось)) / КомпонентаНаправления);
            ДельтаПересечения.Установить(Ось, 1 / Макс(КомпонентаНаправления, -КомпонентаНаправления));
        КонецЕсли;
    КонецЦикла;

    Для Переход = 1 По 64 Цикл
        Для Ось = 0 По 2 Цикл
            Если Ячейка.Получить(Ось) < 0 Или Ячейка.Получить(Ось) >= Размеры.Получить(Ось) Тогда
                Возврат Промах();
            КонецЕсли;
        КонецЦикла;

        Если Расстояние > ВремяКонца + Эпсилон Тогда
            Возврат Промах();
        КонецЕсли;

        Если Мир.ПолучитьБлок(
            Ячейка.Получить(0), Ячейка.Получить(1), Ячейка.Получить(2)) <> 0 Тогда
            Если НормальНулевая(Нормаль) Тогда
                Возврат Промах();
            КонецЕсли;
            Возврат СоздатьПопадание(
                Ячейка.Получить(0), Ячейка.Получить(1), Ячейка.Получить(2),
                Нормаль, Макс(0, Расстояние));
        КонецЕсли;

        СледующееПересечение = Мин(
            Мин(МаксимумПересечения.Получить(0), МаксимумПересечения.Получить(1)),
            МаксимумПересечения.Получить(2));
        Если СледующееПересечение > ВремяКонца + Эпсилон Тогда
            Возврат Промах();
        КонецЕсли;

        Для Ось = 0 По 2 Цикл
            Нормаль.Установить(Ось, 0);
        КонецЦикла;
        Для Ось = 0 По 2 Цикл
            Если Макс(
                МаксимумПересечения.Получить(Ось) - СледующееПересечение,
                СледующееПересечение - МаксимумПересечения.Получить(Ось)) <= Эпсилон Тогда
                Ячейка.Установить(Ось, Ячейка.Получить(Ось) + Шаг.Получить(Ось));
                МаксимумПересечения.Установить(
                    Ось,
                    МаксимумПересечения.Получить(Ось) + ДельтаПересечения.Получить(Ось));
                Если НормальНулевая(Нормаль) Тогда
                    Нормаль.Установить(Ось, -Шаг.Получить(Ось));
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Расстояние = СледующееПересечение;
    КонецЦикла;

    Возврат Промах();
КонецФункции
