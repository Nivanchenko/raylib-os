Перем КонтекстRaylib;
Перем Shader;
Перем ShaderСоздан;
Перем LocationВремя;
Перем LocationМатериал;
Перем LocationСвет;
Перем НаправлениеСвета;
Перем ЦветаМатериалов;
Перем ГруппыМатериалов;
Перем ВерсияКэшаМира;

Процедура Инициализировать(Рейлиб, Мир) Экспорт
    КонтекстRaylib = Рейлиб;
    ShaderСоздан = Ложь;
    ВерсияКэшаМира = -1;

    Shader = КонтекстRaylib.ЗагрузитьШейдер(
        "resources/shaders/minecraft/blocks.vs",
        "resources/shaders/minecraft/blocks.fs");
    Если Не КонтекстRaylib.ШейдерГотов(Shader) Тогда
        ВызватьИсключение "Renderer shader не загрузился; проверьте лог SHADER и файлы resources/shaders/minecraft/";
    КонецЕсли;

    LocationВремя = КонтекстRaylib.ПозицияПараметраШейдера(Shader, "uTime");
    LocationМатериал = КонтекстRaylib.ПозицияПараметраШейдера(Shader, "uMaterial");
    LocationСвет = КонтекстRaylib.ПозицияПараметраШейдера(Shader, "uLightDirection");
    Если LocationВремя < 0 Или LocationМатериал < 0 Или LocationСвет < 0 Тогда
        ВызватьИсключение "Renderer shader не содержит обязательный uniform";
    КонецЕсли;

    // Помечаем shader своим только после проверки location: при ошибке
    // raylib может вернуть стандартный shader, который выгружать нельзя.
    ShaderСоздан = Истина;
    НаправлениеСвета = КонтекстRaylib.НовыйВектор3(0.4, 1.0, 0.3);

    ЦветаМатериалов = Новый Массив;
    ЦветаМатериалов.Добавить(КонтекстRaylib.НовыйЦвет(134, 91, 55, 255));
    ЦветаМатериалов.Добавить(КонтекстRaylib.НовыйЦвет(38, 126, 165, 255));
    ЦветаМатериалов.Добавить(КонтекстRaylib.НовыйЦвет(155, 112, 64, 255));

    ГруппыМатериалов = Новый Массив;
    Для Индекс = 0 По 2 Цикл
        ГруппыМатериалов.Добавить(Новый Массив);
    КонецЦикла;

    Синхронизировать(Рейлиб, Мир);
КонецПроцедуры

Процедура Синхронизировать(Рейлиб, Мир) Экспорт
    Если ВерсияКэшаМира = Мир.Версия Тогда
        Возврат;
    КонецЕсли;

    ГруппыМатериалов = Новый Массив;
    Для Индекс = 0 По 2 Цикл
        ГруппыМатериалов.Добавить(Новый Массив);
    КонецЦикла;

    Для Каждого Блок Из Мир.ОткрытыеБлоки() Цикл
        Центр = КонтекстRaylib.НовыйВектор3(Блок.X + 0.5, Блок.Y + 0.5, Блок.Z + 0.5);
        Цвет = ЦветаМатериалов.Получить(Блок.Тип - 1);
        Запись = Новый Структура(
            "X,Y,Z,Позиция,Цвет", Блок.X + 0.5, Блок.Y + 0.5, Блок.Z + 0.5, Центр, Цвет);
        ГруппыМатериалов.Получить(Блок.Тип - 1).Добавить(Запись);
    КонецЦикла;

    ВерсияКэшаМира = Мир.Версия;
КонецПроцедуры

Функция Нарисовать(Рейлиб, Мир, ПозицияИгрока, Время) Экспорт
    Синхронизировать(Рейлиб, Мир);

    КонтекстRaylib.УстановитьЗначениеШейдераFloat(Shader, LocationВремя, Время);
    КонтекстRaylib.УстановитьЗначениеШейдераVector3(Shader, LocationСвет, НаправлениеСвета);

    ЧислоНарисованныхКубов = 0;
    Для ТипМатериала = 1 По 3 Цикл
        КонтекстRaylib.УстановитьЗначениеШейдераInt(Shader, LocationМатериал, ТипМатериала);
        КонтекстRaylib.НачатьРежимШейдера(Shader);

        СписокБлоков = ГруппыМатериалов.Получить(ТипМатериала - 1);
        Для ИндексБлока = 0 По СписокБлоков.Количество() - 1 Цикл
            Блок = СписокБлоков.Получить(ИндексБлока);
            DX = Блок.X - ПозицияИгрока.X;
            DY = Блок.Y - ПозицияИгрока.Y;
            DZ = Блок.Z - ПозицияИгрока.Z;
            Если DX * DX + DY * DY + DZ * DZ <= 576 Тогда
                КонтекстRaylib.НарисоватьКуб(Блок.Позиция, 1, 1, 1, Блок.Цвет);
                ЧислоНарисованныхКубов = ЧислоНарисованныхКубов + 1;
            КонецЕсли;
        КонецЦикла;

        КонтекстRaylib.ЗакончитьРежимШейдера();
    КонецЦикла;

    Возврат ЧислоНарисованныхКубов;
КонецФункции

Процедура Завершить(Рейлиб) Экспорт
    Если ShaderСоздан Тогда
        КонтекстRaylib.ВыгрузитьШейдер(Shader);
    КонецЕсли;

    ShaderСоздан = Ложь;
    ВерсияКэшаМира = -1;
КонецПроцедуры
