#Использовать "."

Перем Рейлиб;
Перем КонтекстСоздан;
Перем ОкноПопыталосьСоздаться;
Перем РендерПопыталсяИнициализироваться;

Функция ЧислоПоФлагу(Флаг)
    Если Флаг Тогда
        Возврат 1;
    КонецЕсли;
    Возврат 0;
КонецФункции

Процедура ОчиститьПослеОшибки()
    Если РендерПопыталсяИнициализироваться Тогда
        Попытка
            Отрисовка.Завершить(Рейлиб);
        Исключение
            ОшибкаОчисткиШейдера = ОписаниеОшибки();
        КонецПопытки;
    КонецЕсли;

    Если Не КонтекстСоздан Или Не ОкноПопыталосьСоздаться Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Если Рейлиб.ОкноГотово() Тогда
            Рейлиб.ВключитьКурсор();
        КонецЕсли;
    Исключение
        ОшибкаОсвобожденияКурсора = ОписаниеОшибки();
    КонецПопытки;

    Попытка
        Если Рейлиб.ОкноГотово() Тогда
            Рейлиб.ЗакрытьОкно();
        КонецЕсли;
    Исключение
        ОшибкаЗакрытияОкна = ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

КонтекстСоздан = Ложь;
ОкноПопыталосьСоздаться = Ложь;
РендерПопыталсяИнициализироваться = Ложь;

Попытка
    КаталогКомпоненты = ОбъединитьПути(
        ТекущийСценарий().Каталог,
        "../../src/raylibos/bin/Debug/net6.0/raylibos.dll");
    ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
    Рейлиб = Новый Рейлиб;
    КонтекстСоздан = Истина;

    // FLAG_WINDOW_RESIZABLE должен задаваться до InitWindow.
    Рейлиб.УстановитьФлагиКонфигурации(4);
    ОкноПопыталосьСоздаться = Истина;
    Рейлиб.ИнициализацияОкна("Raylib-os voxel demo", 960, 540);
    Если Не Рейлиб.ОкноГотово() Тогда
        ВызватьИсключение "Не удалось создать окно voxel-демо";
    КонецЕсли;
    Рейлиб.УстановитьЧастотуКадров(60);

    Мир = Новый Мир();
    Игрок = Новый Игрок();
    РендерПопыталсяИнициализироваться = Истина;
    Отрисовка.Инициализировать(Рейлиб, Мир);

    УправлениеАктивно = Рейлиб.ОкноВФокусе();
    ФокусБыл = УправлениеАктивно;
    ПропуститьDelta = УправлениеАктивно;
    Если УправлениеАктивно Тогда
        Рейлиб.ОтключитьКурсор();
    Иначе
        Рейлиб.ВключитьКурсор();
    КонецЕсли;

    ВыбранныйТип = 1;
    СообщениеРедактирования = "";
    Белый = Рейлиб.НовыйЦвет(245, 245, 245, 255);
    ЦветРамки = Рейлиб.НовыйЦвет(255, 220, 64, 255);
    Фон = Рейлиб.НовыйЦвет(24, 31, 46, 255);
    Вверх = Рейлиб.НовыйВектор3(0, 1, 0);
    НулевоеНаправление = Новый Структура("X,Y,Z", 0, 0, 0);

    Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл
        ПропуститьВводКадра = Ложь;
        ОкноВФокусе = Рейлиб.ОкноВФокусе();

        Если Не ОкноВФокусе Тогда
            Если УправлениеАктивно Тогда
                УправлениеАктивно = Ложь;
                ПропуститьDelta = Ложь;
                Рейлиб.ВключитьКурсор();
            КонецЕсли;
            ФокусБыл = Ложь;
            ПропуститьВводКадра = Истина;
        ИначеЕсли Не ФокусБыл Тогда
            // Возврат фокуса не захватывает мышь автоматически.
            ФокусБыл = Истина;
            УправлениеАктивно = Ложь;
            ПропуститьDelta = Ложь;
            Рейлиб.ВключитьКурсор();
            ПропуститьВводКадра = Истина;
        ИначеЕсли Рейлиб.КлавишаНажатаОдин(258) Тогда // KEY_TAB
            УправлениеАктивно = Не УправлениеАктивно;
            Если УправлениеАктивно Тогда
                Рейлиб.ОтключитьКурсор();
                ПропуститьDelta = Истина;
            Иначе
                Рейлиб.ВключитьКурсор();
                ПропуститьDelta = Ложь;
            КонецЕсли;
            ПропуститьВводКадра = Истина;
        КонецЕсли;

        Если УправлениеАктивно И Не ПропуститьВводКадра Тогда
            СмещениеМыши = Рейлиб.СмещениеМыши();
            Если ПропуститьDelta Тогда
                // Поглотить первое накопленное смещение после захвата.
                ПропуститьDelta = Ложь;
            Иначе
                Игрок.Повернуть(
                    Рейлиб.ВекторX(СмещениеМыши),
                    Рейлиб.ВекторY(СмещениеМыши));
            КонецЕсли;

            Вперёд = ЧислоПоФлагу(Рейлиб.КлавишаНажата(87))
                - ЧислоПоФлагу(Рейлиб.КлавишаНажата(83));
            Вправо = ЧислоПоФлагу(Рейлиб.КлавишаНажата(68))
                - ЧислоПоФлагу(Рейлиб.КлавишаНажата(65));
            ВверхВвод = ЧислоПоФлагу(Рейлиб.КлавишаНажата(32))
                - ЧислоПоФлагу(Рейлиб.КлавишаНажата(341));
            Игрок.Переместить(Вперёд, Вправо, ВверхВвод, Рейлиб.ВремяКадра());

            Если Рейлиб.КлавишаНажатаОдин(49) Тогда
                ВыбранныйТип = 1;
            ИначеЕсли Рейлиб.КлавишаНажатаОдин(50) Тогда
                ВыбранныйТип = 2;
            ИначеЕсли Рейлиб.КлавишаНажатаОдин(51) Тогда
                ВыбранныйТип = 3;
            КонецЕсли;
        КонецЕсли;

        ПозицияИгрока = Игрок.Позиция();
        НаправлениеИгрока = Игрок.Направление();
        НаправлениеПрицела = НаправлениеИгрока;
        Если Не УправлениеАктивно Тогда
            НаправлениеПрицела = НулевоеНаправление;
        КонецЕсли;
        Выбор = ВоксельныйЛуч.Трассировать(Мир, ПозицияИгрока, НаправлениеПрицела, 5);

        Если УправлениеАктивно И Не ПропуститьВводКадра Тогда
            Если Рейлиб.КнопкаМышиНажата(0) Тогда
                РезультатРедактирования = Редактирование.Удалить(Мир, Выбор);
            ИначеЕсли Рейлиб.КнопкаМышиНажата(1) Тогда
                РезультатРедактирования = Редактирование.Поставить(
                    Мир, Выбор, ВыбранныйТип, ПозицияИгрока);
            Иначе
                РезультатРедактирования = Неопределено;
            КонецЕсли;

            Если РезультатРедактирования <> Неопределено Тогда
                СообщениеРедактирования = РезультатРедактирования.Причина;
                Если РезультатРедактирования.Изменено Тогда
                    Отрисовка.Синхронизировать(Рейлиб, Мир);
                    Выбор = ВоксельныйЛуч.Трассировать(
                        Мир, ПозицияИгрока, НаправлениеИгрока, 5);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;

        ПозицияКамеры = Рейлиб.НовыйВектор3(
            ПозицияИгрока.X, ПозицияИгрока.Y, ПозицияИгрока.Z);
        ЦельКамеры = Рейлиб.НовыйВектор3(
            ПозицияИгрока.X + НаправлениеИгрока.X,
            ПозицияИгрока.Y + НаправлениеИгрока.Y,
            ПозицияИгрока.Z + НаправлениеИгрока.Z);
        Камера = Рейлиб.НоваяКамера3D(ПозицияКамеры, ЦельКамеры, Вверх, 70, 0);

        Рейлиб.НачатьОтрисовку();
        Рейлиб.ОчиститьФон(Фон);
        Рейлиб.НачатьРежим3D(Камера);
        Отрисовка.Нарисовать(Рейлиб, Мир, ПозицияИгрока, Рейлиб.ВремяРаботы());
        Если Выбор.Попадание Тогда
            ЦентрЦели = Рейлиб.НовыйВектор3(
                Выбор.X + 0.5, Выбор.Y + 0.5, Выбор.Z + 0.5);
            Рейлиб.НарисоватьКубЛиния(ЦентрЦели, 1.02, 1.02, 1.02, ЦветРамки);
        КонецЕсли;
        Рейлиб.ЗакончитьРежим3D();

        ШиринаHUD = Макс(1, Рейлиб.ШиринаЭкрана());
        ВысотаHUD = Макс(1, Рейлиб.ВысотаЭкрана());
        ЦентрX = Цел(ШиринаHUD / 2);
        ЦентрY = Цел(ВысотаHUD / 2);
        Рейлиб.НарисоватьЛинию(ЦентрX - 8, ЦентрY, ЦентрX - 2, ЦентрY, Белый);
        Рейлиб.НарисоватьЛинию(ЦентрX + 2, ЦентрY, ЦентрX + 8, ЦентрY, Белый);
        Рейлиб.НарисоватьЛинию(ЦентрX, ЦентрY - 8, ЦентрX, ЦентрY - 2, Белый);
        Рейлиб.НарисоватьЛинию(ЦентрX, ЦентрY + 2, ЦентрX, ЦентрY + 8, Белый);

        Рейлиб.НарисоватьТекст("WASD: fly   Space/Ctrl: up/down   Tab: cursor", 12, 12, 18, Белый);
        Рейлиб.НарисоватьТекст("FPS: " + Строка(Рейлиб.ТекущийFPS()), 12, 36, 18, Белый);
        Если ВыбранныйТип = 1 Тогда
            НазваниеТипа = "DIRT";
        ИначеЕсли ВыбранныйТип = 2 Тогда
            НазваниеТипа = "WATER";
        Иначе
            НазваниеТипа = "WOOD";
        КонецЕсли;
        Рейлиб.НарисоватьТекст(
            "Block: " + НазваниеТипа + " (1/2/3)", 12, 60, 18, Белый);
        Если УправлениеАктивно Тогда
            Рейлиб.НарисоватьТекст("Cursor captured", 12, 84, 18, Белый);
        Иначе
            Рейлиб.НарисоватьТекст("Press Tab to capture cursor", 12, 84, 18, Белый);
        КонецЕсли;
        Если СообщениеРедактирования <> "" Тогда
            Рейлиб.НарисоватьТекст(
                "Edit: " + СообщениеРедактирования, 12, 108, 18, Белый);
        КонецЕсли;
        Рейлиб.ЗакончитьОтрисовку();
    КонецЦикла;

    Отрисовка.Завершить(Рейлиб);
    РендерПопыталсяИнициализироваться = Ложь;
    Рейлиб.ВключитьКурсор();
    Рейлиб.ЗакрытьОкно();
    ОкноПопыталосьСоздаться = Ложь;
Исключение
    ИсходнаяОшибка = ОписаниеОшибки();
    ОчиститьПослеОшибки();
    ВызватьИсключение ИсходнаяОшибка;
КонецПопытки
