Перем ПозицияX;
Перем ПозицияY;
Перем ПозицияZ;
Перем Yaw;
Перем Pitch;

Процедура ПриСозданииОбъекта(X = 8, Y = 6, Z = 14, НачальныйYaw = 0, НачальныйPitch = -0.349065850398866)
    ПозицияX = X;
    ПозицияY = Y;
    ПозицияZ = Z;
    Yaw = НачальныйYaw;
    Pitch = НачальныйPitch;

    ОграничитьPitch();
    ОбернутьYaw();
КонецПроцедуры

Процедура ОграничитьPitch()
    ПределPitch = 85 * 3.141592653589793 / 180;
    Если Pitch > ПределPitch Тогда
        Pitch = ПределPitch;
    ИначеЕсли Pitch < -ПределPitch Тогда
        Pitch = -ПределPitch;
    КонецЕсли;
КонецПроцедуры

Процедура ОбернутьYaw()
    Пи = 3.141592653589793;
    Пока Yaw > Пи Цикл
        Yaw = Yaw - 2 * Пи;
    КонецЦикла;
    Пока Yaw < -Пи Цикл
        Yaw = Yaw + 2 * Пи;
    КонецЦикла;
КонецПроцедуры

Функция Позиция() Экспорт
    Возврат Новый Структура("X,Y,Z", ПозицияX, ПозицияY, ПозицияZ);
КонецФункции

Функция Направление() Экспорт
    CosPitch = Cos(Pitch);
    Возврат Новый Структура(
        "X,Y,Z",
        Sin(Yaw) * CosPitch,
        Sin(Pitch),
        -Cos(Yaw) * CosPitch);
КонецФункции

Функция Углы() Экспорт
    Возврат Новый Структура("Yaw,Pitch", Yaw, Pitch);
КонецФункции

Процедура Повернуть(DeltaX, DeltaY) Экспорт
    Yaw = Yaw + DeltaX * 0.0025;
    Pitch = Pitch - DeltaY * 0.0025;
    ОграничитьPitch();
    ОбернутьYaw();
КонецПроцедуры

Процедура Переместить(Вперёд, Вправо, Вверх, Dt) Экспорт
    Если Dt < 0 Тогда
        Dt = 0;
    ИначеЕсли Dt > 0.05 Тогда
        Dt = 0.05;
    КонецЕсли;

    Если Dt = 0 Тогда
        Возврат;
    КонецЕсли;

    ДвижениеX = Sin(Yaw) * Вперёд + Cos(Yaw) * Вправо;
    ДвижениеY = Вверх;
    ДвижениеZ = -Cos(Yaw) * Вперёд + Sin(Yaw) * Вправо;
    ДлинаДвижения = Sqrt(
        ДвижениеX * ДвижениеX
        + ДвижениеY * ДвижениеY
        + ДвижениеZ * ДвижениеZ);

    Если ДлинаДвижения = 0 Тогда
        Возврат;
    КонецЕсли;

    Перемещение = 4 * Dt / ДлинаДвижения;
    ПозицияX = ПозицияX + ДвижениеX * Перемещение;
    ПозицияY = ПозицияY + ДвижениеY * Перемещение;
    ПозицияZ = ПозицияZ + ДвижениеZ * Перемещение;
КонецПроцедуры
