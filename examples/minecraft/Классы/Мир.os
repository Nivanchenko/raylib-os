Перем Блоки;
Перем КэшОткрытыхБлоков;
Перем КэшГрязный;
Перем Версия Экспорт;

Процедура ПриСозданииОбъекта()
    Блоки = Новый Массив;
    Для ИндексБлока = 0 По 2047 Цикл
        Блоки.Добавить(0);
    КонецЦикла;

    Версия = 0;
    КэшОткрытыхБлоков = Новый Массив;
    КэшГрязный = Истина;

    ПостроитьИсходнуюСцену();
КонецПроцедуры

Процедура ПостроитьИсходнуюСцену()
    // Два нижних слоя земли.
    Для Z = 0 По 15 Цикл
        Для X = 0 По 15 Цикл
            УстановитьБлок(X, 0, Z, 1);
            УстановитьБлок(X, 1, Z, 1);
        КонецЦикла;
    КонецЦикла;

    // Ступенчатый холм.
    Для Z = 3 По 6 Цикл
        Для X = 2 По 5 Цикл
            УстановитьБлок(X, 2, Z, 1);
        КонецЦикла;
    КонецЦикла;
    Для Z = 4 По 5 Цикл
        Для X = 3 По 4 Цикл
            УстановитьБлок(X, 3, Z, 1);
        КонецЦикла;
    КонецЦикла;

    // Неглубокий пруд поверх второго слоя земли.
    Для Z = 4 По 7 Цикл
        Для X = 9 По 12 Цикл
            УстановитьБлок(X, 1, Z, 2);
        КонецЦикла;
    КонецЦикла;

    // Два условных дерева из блоков древесины.
    ПостроитьДерево(3);
    ПостроитьДерево(12);
КонецПроцедуры

Процедура ПостроитьДерево(XСтвола)
    Для Y = 2 По 5 Цикл
        УстановитьБлок(XСтвола, Y, 11, 3);
    КонецЦикла;
    УстановитьБлок(XСтвола - 1, 5, 11, 3);
    УстановитьБлок(XСтвола + 1, 5, 11, 3);
    УстановитьБлок(XСтвола, 5, 10, 3);
    УстановитьБлок(XСтвола, 6, 11, 3);
КонецПроцедуры

Функция КоординатыЦелые(X, Y, Z)
    Возврат X = Цел(X) И Y = Цел(Y) И Z = Цел(Z);
КонецФункции

Функция ИндексБлока(X, Y, Z)
    Возврат X + 16 * (Z + 16 * Y);
КонецФункции

Функция БлокОткрыт(X, Y, Z)
    Возврат ПолучитьБлок(X + 1, Y, Z) = 0
        Или ПолучитьБлок(X - 1, Y, Z) = 0
        Или ПолучитьБлок(X, Y + 1, Z) = 0
        Или ПолучитьБлок(X, Y - 1, Z) = 0
        Или ПолучитьБлок(X, Y, Z + 1) = 0
        Или ПолучитьБлок(X, Y, Z - 1) = 0;
КонецФункции

Функция ВГраницах(X, Y, Z) Экспорт
    Если Не КоординатыЦелые(X, Y, Z) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат X >= 0 И X < 16 И Y >= 0 И Y < 8 И Z >= 0 И Z < 16;
КонецФункции

Функция ПолучитьБлок(X, Y, Z) Экспорт
    Если Не ВГраницах(X, Y, Z) Тогда
        Возврат 0;
    КонецЕсли;

    Возврат Блоки.Получить(ИндексБлока(X, Y, Z));
КонецФункции

Функция УстановитьБлок(X, Y, Z, ТипБлока) Экспорт
    Если Не ВГраницах(X, Y, Z) Тогда
        Возврат Ложь;
    КонецЕсли;
    Если ТипБлока <> Цел(ТипБлока) Или ТипБлока < 0 Или ТипБлока > 3 Тогда
        Возврат Ложь;
    КонецЕсли;

    Индекс = ИндексБлока(X, Y, Z);
    Если Блоки.Получить(Индекс) = ТипБлока Тогда
        Возврат Ложь;
    КонецЕсли;

    Блоки.Установить(Индекс, ТипБлока);
    Версия = Версия + 1;
    КэшГрязный = Истина;
    Возврат Истина;
КонецФункции

Процедура Очистить() Экспорт
    Изменён = Ложь;
    Для Индекс = 0 По 2047 Цикл
        Если Блоки.Получить(Индекс) <> 0 Тогда
            Блоки.Установить(Индекс, 0);
            Изменён = Истина;
        КонецЕсли;
    КонецЦикла;

    Если Изменён Тогда
        Версия = Версия + 1;
        КэшГрязный = Истина;
    КонецЕсли;
КонецПроцедуры

Функция ОткрытыеБлоки() Экспорт
    Если Не КэшГрязный Тогда
        Возврат КэшОткрытыхБлоков;
    КонецЕсли;

    КэшОткрытыхБлоков = Новый Массив;
    Для Y = 0 По 7 Цикл
        Для Z = 0 По 15 Цикл
            Для X = 0 По 15 Цикл
                ТипБлока = ПолучитьБлок(X, Y, Z);
                Если ТипБлока <> 0 И БлокОткрыт(X, Y, Z) Тогда
                    ДанныеБлока = Новый Структура("X,Y,Z,Тип", X, Y, Z, ТипБлока);
                    КэшОткрытыхБлоков.Добавить(ДанныеБлока);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;

    КэшГрязный = Ложь;
    Возврат КэшОткрытыхБлоков;
КонецФункции
