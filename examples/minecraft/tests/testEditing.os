#Использовать ".."

Процедура Проверить(Условие, Сообщение)
    Если Не Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьИзменение(Результат, Изменено, Причина, Сообщение)
    Проверить(Результат.Изменено = Изменено, Сообщение + ": флаг изменения");
    Проверить(Результат.Причина = Причина, Сообщение + ": причина");
КонецПроцедуры

Функция СоздатьБазовыйМир()
    Результат = Новый Мир();
    Результат.Очистить();
    Результат.УстановитьБлок(2, 2, 2, 1);
    Возврат Результат;
КонецФункции

Функция ВыборЦелевогоБлока(Мир)
    Возврат ВоксельныйЛуч.Трассировать(
        Мир,
        Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
        Новый Структура("X,Y,Z", 1, 0, 0),
        5);
КонецФункции

Функция СнимокМира(Мир)
    Снимок = Новый Массив;
    Для Y = 0 По 7 Цикл
        Для Z = 0 По 15 Цикл
            Для X = 0 По 15 Цикл
                Снимок.Добавить(Мир.ПолучитьБлок(X, Y, Z));
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    Возврат Снимок;
КонецФункции

Процедура ПроверитьСеткаИВерсия(Мир, НачальнаяВерсия, Снимок, Сообщение)
    Проверить(Мир.Версия = НачальнаяВерсия, Сообщение + ": версия не изменилась");
    Индекс = 0;
    Для Y = 0 По 7 Цикл
        Для Z = 0 По 15 Цикл
            Для X = 0 По 15 Цикл
                Если Мир.ПолучитьБлок(X, Y, Z) <> Снимок.Получить(Индекс) Тогда
                    ВызватьИсключение Сообщение + ": изменилась клетка "
                        + Строка(X) + "," + Строка(Y) + "," + Строка(Z);
                КонецЕсли;
                Индекс = Индекс + 1;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОтказУстановки(Мир, Выбор, Тип, Позиция, Причина, Сообщение)
    НачальнаяВерсия = Мир.Версия;
    Снимок = СнимокМира(Мир);
    Результат = Редактирование.Поставить(Мир, Выбор, Тип, Позиция);
    ПроверитьИзменение(Результат, Ложь, Причина, Сообщение);
    ПроверитьСеткаИВерсия(Мир, НачальнаяВерсия, Снимок, Сообщение);
КонецПроцедуры

Процедура ПроверитьНеверныйТип(Тип)
    Мир = СоздатьБазовыйМир();
    ПроверитьОтказУстановки(
        Мир,
        ВыборЦелевогоБлока(Мир),
        Тип,
        Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
        "invalid-type",
        "E06: неверный тип " + Строка(Тип));
КонецПроцедуры

ПозицияКамеры = Новый Структура("X,Y,Z", 0.5, 2.5, 2.5);

// E01: удаление выбранного блока меняет ровно его и увеличивает версию.
Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
ВерсияДоУдаления = Мир.Версия;
Результат = Редактирование.Удалить(Мир, Выбор);
ПроверитьИзменение(Результат, Истина, "ok", "E01: удаление цели");
Проверить(Мир.ПолучитьБлок(2, 2, 2) = 0, "E01: целевая клетка стала воздухом");
Проверить(Мир.Версия = ВерсияДоУдаления + 1, "E01: версия увеличилась на один");

// E02: промах запрещает операцию и сохраняет всю сетку.
Мир = СоздатьБазовыйМир();
Промах = ВоксельныйЛуч.Трассировать(
    Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 0, 0, 0),
    5);
НачальнаяВерсия = Мир.Версия;
Снимок = СнимокМира(Мир);
Результат = Редактирование.Удалить(Мир, Промах);
ПроверитьИзменение(Результат, Ложь, "no-hit", "E02: удаление промаха");
ПроверитьСеткаИВерсия(Мир, НачальнаяВерсия, Снимок, "E02: состояние мира");

// E03: устаревший выбор после удаления отклоняется как no-hit.
Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
Редактирование.Удалить(Мир, Выбор);
НачальнаяВерсия = Мир.Версия;
Снимок = СнимокМира(Мир);
Результат = Редактирование.Удалить(Мир, Выбор);
ПроверитьИзменение(Результат, Ложь, "no-hit", "E03: повтор старого выбора");
ПроверитьСеткаИВерсия(Мир, НачальнаяВерсия, Снимок, "E03: состояние мира");

// E04: все три разрешённых типа устанавливаются в один и тот же пустой сосед.
Для Тип = 1 По 3 Цикл
    Мир = СоздатьБазовыйМир();
    Выбор = ВыборЦелевогоБлока(Мир);
    ВерсияДоУстановки = Мир.Версия;
    Результат = Редактирование.Поставить(Мир, Выбор, Тип, ПозицияКамеры);
    ПроверитьИзменение(Результат, Истина, "ok", "E04: установка типа " + Строка(Тип));
    Проверить(Мир.ПолучитьБлок(1, 2, 2) = Тип, "E04: ID установленного соседа");
    Проверить(Мир.ПолучитьБлок(2, 2, 2) = 1, "E04: блок-цель сохранён");
    Проверить(Мир.Версия = ВерсияДоУстановки + 1, "E04: версия увеличилась на один");
КонецЦикла;

// E05: занятая клетка-сосед не затирается.
Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
Мир.УстановитьБлок(1, 2, 2, 3);
ПроверитьОтказУстановки(
    Мир, Выбор, 2, ПозицияКамеры, "occupied", "E05: сосед занят");

// E06: типы вне целых ID 1..3 отклоняются без изменений сетки.
ПроверитьНеверныйТип(0);
ПроверитьНеверныйТип(4);
ПроверитьНеверныйТип(1.5);

// E07: пересечение целевого куба с кубом безопасности камеры.
Мир = СоздатьБазовыйМир();
ПроверитьОтказУстановки(
    Мир,
    ВыборЦелевогоБлока(Мир),
    3,
    Новый Структура("X,Y,Z", 1.5, 2.5, 2.5),
    "near-camera",
    "E07: камера внутри соседнего куба");

// E08: точное касание границы безопасности не считается пересечением.
Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
ВерсияДоУстановки = Мир.Версия;
Результат = Редактирование.Поставить(
    Мир, Выбор, 1, Новый Структура("X,Y,Z", 0.8, 2.5, 2.5));
ПроверитьИзменение(Результат, Истина, "ok", "E08: касание разрешено");
Проверить(Мир.ПолучитьБлок(1, 2, 2) = 1, "E08: сосед установлен");
Проверить(Мир.Версия = ВерсияДоУстановки + 1, "E08: версия увеличилась на один");

// E09: даже небольшое строгое пересечение запрещает установку.
Мир = СоздатьБазовыйМир();
ПроверитьОтказУстановки(
    Мир,
    ВыборЦелевогоБлока(Мир),
    1,
    Новый Структура("X,Y,Z", 0.81, 2.5, 2.5),
    "near-camera",
    "E09: камера пересекает соседний куб");

// E10: реальное попадание по блоку на границе мира; нормаль ведёт за X=0.
Мир = Новый Мир();
Мир.Очистить();
Мир.УстановитьБлок(0, 2, 2, 1);
Выбор = ВоксельныйЛуч.Трассировать(
    Мир,
    Новый Структура("X,Y,Z", -1.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0),
    5);
Проверить(Выбор.Попадание И Выбор.X = 0, "E10: луч действительно выбрал блок на границе");
Проверить(Выбор.NX = -1 И Выбор.NY = 0 И Выбор.NZ = 0, "E10: нормаль ведёт за границу");
ПроверитьОтказУстановки(
    Мир,
    Выбор,
    2,
    Новый Структура("X,Y,Z", -1.5, 2.5, 2.5),
    "bounds",
    "E10: установка вне сетки");

// E11: допустимая нормаль — только одна целая компонента ±1.
Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
Выбор.NX = 0;
Выбор.NY = 0;
Выбор.NZ = 0;
ПроверитьОтказУстановки(
    Мир, Выбор, 1, ПозицияКамеры, "invalid-hit", "E11: нулевая нормаль");

Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
Выбор.NX = 1;
Выбор.NY = 1;
Выбор.NZ = 0;
ПроверитьОтказУстановки(
    Мир, Выбор, 1, ПозицияКамеры, "invalid-hit", "E11: диагональная нормаль");

// E12: устаревшая дальность или дробная координата цели дают no-hit.
Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
Выбор.Расстояние = 5.001;
ПроверитьОтказУстановки(
    Мир, Выбор, 1, ПозицияКамеры, "no-hit", "E12: цель дальше дальности");

Мир = СоздатьБазовыйМир();
Выбор = ВыборЦелевогоБлока(Мир);
Выбор.X = 2.5;
ПроверитьОтказУстановки(
    Мир, Выбор, 1, ПозицияКамеры, "no-hit", "E12: дробная координата цели");

// E13: удаление внутреннего блока инвалидирует кэш открытых кубов.
Мир = Новый Мир();
Мир.Очистить();
Для Y = 1 По 5 Цикл
    Для Z = 1 По 5 Цикл
        Для X = 1 По 5 Цикл
            Мир.УстановитьБлок(X, Y, Z, 1);
        КонецЦикла;
    КонецЦикла;
КонецЦикла;
Проверить(Мир.ОткрытыеБлоки().Количество() = 98, "E13: исходный кэш поверхности 5³");
ВерсияДоУдаления = Мир.Версия;
Выбор = Новый Структура(
    "Попадание,X,Y,Z,NX,NY,NZ,Расстояние",
    Истина, 3, 3, 3, 1, 0, 0, 2.5);
Результат = Редактирование.Удалить(Мир, Выбор);
ПроверитьИзменение(Результат, Истина, "ok", "E13: удаление центра 5³");
Проверить(Мир.ПолучитьБлок(3, 3, 3) = 0, "E13: центр удалён");
Проверить(Мир.Версия = ВерсияДоУдаления + 1, "E13: версия кэша изменилась");
Проверить(Мир.ОткрытыеБлоки().Количество() = 104, "E13: перестроенный кэш содержит 104 блока");

Сообщить("Editing: OK");
