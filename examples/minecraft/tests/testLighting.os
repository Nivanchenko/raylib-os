#Использовать ".."

КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "../../../src/raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Minecraft renderer - lighting probe", 640, 400);
Рейлиб.УстановитьЧастотуКадров(30);

Мир = Новый Мир();
Мир.Очистить();
Мир.УстановитьБлок(5, 0, 5, 1);
Мир.УстановитьБлок(8, 0, 5, 2);
Мир.УстановитьБлок(11, 0, 5, 3);

Попытка
    Отрисовка.Инициализировать(Рейлиб, Мир);
Исключение
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Не удалось инициализировать renderer shader; см. лог SHADER";
КонецПопытки;

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);

ЦельКамеры = Рейлиб.НовыйВектор3(8, 0.5, 5);
ПозицияИгрока = Новый Структура("X,Y,Z", 8, 8, 16);
Вверх = Рейлиб.НовыйВектор3(0, 1, 0);
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 3 Цикл
    УголКамеры = (Рейлиб.ВремяРаботы() - Начало) * 2 * 3.141592653589793 / 3;
    ПозицияКамеры = Рейлиб.НовыйВектор3(
        8 + Sin(УголКамеры) * 9,
        7,
        5 + Cos(УголКамеры) * 9);
    Камера = Рейлиб.НоваяКамера3D(ПозицияКамеры, ЦельКамеры, Вверх, 45, 0);

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Рейлиб.НовыйЦвет(24, 31, 46, 255));
    Рейлиб.НачатьРежим3D(Камера);
    ЧислоКубов = Отрисовка.Нарисовать(Рейлиб, Мир, ПозицияИгрока, Рейлиб.ВремяРаботы() - Начало);
    Рейлиб.ЗакончитьРежим3D();
    Если ЧислоКубов <> 3 Тогда
        Отрисовка.Завершить(Рейлиб);
        Рейлиб.ЗакрытьОкно();
        ВызватьИсключение "Renderer должен рисовать все три тестовых блока";
    КонецЕсли;
    Рейлиб.НарисоватьТекст("DIRT       WATER       WOOD", 212, 24, 18, Белый);
    Рейлиб.НарисоватьТекст("Orbiting camera: check stable world-space light", 92, 52, 16, Белый);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Отрисовка.Завершить(Рейлиб);
Рейлиб.ЗакрытьОкно();
Сообщить("Lighting: OK");
