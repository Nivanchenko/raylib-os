#Использовать ".."

КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "../../../src/raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Minecraft renderer - material and lighting probe", 960, 540);
Рейлиб.УстановитьЧастотуКадров(30);

Мир = Новый Мир();
Мир.Очистить();
Для Y = 0 По 2 Цикл
    Для Z = 4 По 6 Цикл
        Для X = 1 По 3 Цикл
            Мир.УстановитьБлок(X, Y, Z, 1);
        КонецЦикла;
        Для X = 6 По 8 Цикл
            Мир.УстановитьБлок(X, Y, Z, 2);
        КонецЦикла;
        Для X = 11 По 13 Цикл
            Мир.УстановитьБлок(X, Y, Z, 3);
        КонецЦикла;
    КонецЦикла;
КонецЦикла;

Попытка
    Отрисовка.Инициализировать(Рейлиб, Мир);
Исключение
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Не удалось инициализировать renderer shader; см. лог SHADER";
КонецПопытки;

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);

ЦельКамеры = Рейлиб.НовыйВектор3(7, 1.5, 5);
Вверх = Рейлиб.НовыйВектор3(0, 1, 0);
Начало = Рейлиб.ВремяРаботы();
ПровереноОтсечение = Ложь;

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 3 Цикл
    УголКамеры = (Рейлиб.ВремяРаботы() - Начало) * 2 * 3.141592653589793 / 3;
    ПозицияКамеры = Рейлиб.НовыйВектор3(
        7 + Sin(УголКамеры) * 11,
        5,
        5 + Cos(УголКамеры) * 11);
    Камера = Рейлиб.НоваяКамера3D(ПозицияКамеры, ЦельКамеры, Вверх, 45, 0);

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Рейлиб.НовыйЦвет(24, 31, 46, 255));
    Рейлиб.НачатьРежим3D(Камера);
    ПозицияИгрока = Новый Структура(
        "X,Y,Z", 7 + Sin(УголКамеры) * 11, 5, 5 + Cos(УголКамеры) * 11);
    ЧислоКубов = Отрисовка.Нарисовать(
        Рейлиб, Мир, ПозицияИгрока, Рейлиб.ВремяРаботы() - Начало);
    Если ЧислоКубов <> 78 Тогда
        Рейлиб.ЗакончитьРежим3D();
        Отрисовка.Завершить(Рейлиб);
        Рейлиб.ЗакрытьОкно();
        ВызватьИсключение "Renderer должен рисовать 26 открытых кубов каждой группы материалов";
    КонецЕсли;

    Если Не ПровереноОтсечение Тогда
        ДалёкаяПозиция = Новый Структура("X,Y,Z", 100, 100, 100);
        Если Отрисовка.Нарисовать(
            Рейлиб, Мир, ДалёкаяПозиция, Рейлиб.ВремяРаботы() - Начало) <> 0 Тогда
            Рейлиб.ЗакончитьРежим3D();
            Отрисовка.Завершить(Рейлиб);
            Рейлиб.ЗакрытьОкно();
            ВызватьИсключение "Renderer должен отсекать блоки дальше 24 единиц";
        КонецЕсли;
        Если Отрисовка.Нарисовать(
            Рейлиб, Мир, ПозицияИгрока, Рейлиб.ВремяРаботы() - Начало) <> 78 Тогда
            Рейлиб.ЗакончитьРежим3D();
            Отрисовка.Завершить(Рейлиб);
            Рейлиб.ЗакрытьОкно();
            ВызватьИсключение "Движение камеры не должно терять закэшированные блоки";
        КонецЕсли;
        ПровереноОтсечение = Истина;
    КонецЕсли;

    Рейлиб.ЗакончитьРежим3D();
    Рейлиб.НарисоватьТекст("DIRT               WATER               WOOD", 300, 24, 20, Белый);
    Рейлиб.НарисоватьТекст("World-space materials; orbit to inspect light and water", 180, 52, 16, Белый);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Отрисовка.Завершить(Рейлиб);
Рейлиб.ЗакрытьОкно();
Сообщить("Lighting: OK");
