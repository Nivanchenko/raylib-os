#Использовать ".."

Процедура Проверить(Условие, Сообщение)
    Если Не Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКоличествоБлоков(Мир, ЗемляОжидание, ВодаОжидание, ДревесинаОжидание, ВоздухОжидание)
    Земля = 0;
    Вода = 0;
    Древесина = 0;
    Воздух = 0;

    Для Y = 0 По 7 Цикл
        Для Z = 0 По 15 Цикл
            Для X = 0 По 15 Цикл
                ТипБлока = Мир.ПолучитьБлок(X, Y, Z);
                Если ТипБлока = 0 Тогда
                    Воздух = Воздух + 1;
                ИначеЕсли ТипБлока = 1 Тогда
                    Земля = Земля + 1;
                ИначеЕсли ТипБлока = 2 Тогда
                    Вода = Вода + 1;
                ИначеЕсли ТипБлока = 3 Тогда
                    Древесина = Древесина + 1;
                Иначе
                    ВызватьИсключение "В сетке встретился неизвестный ID блока";
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;

    Проверить(Земля = ЗемляОжидание, "Количество земли");
    Проверить(Вода = ВодаОжидание, "Количество воды");
    Проверить(Древесина = ДревесинаОжидание, "Количество древесины");
    Проверить(Воздух = ВоздухОжидание, "Количество воздуха");
    Проверить(Земля + Вода + Древесина + Воздух = 2048, "Общее количество клеток");
КонецПроцедуры

Мир = Новый Мир();
ПроверитьКоличествоБлоков(Мир, 516, 16, 16, 1500);
Проверить(Мир.ПолучитьБлок(0, 0, 0) = 1, "W02: базовый слой");
Проверить(Мир.ПолучитьБлок(3, 3, 4) = 1, "W02: верхний уровень холма");
Проверить(Мир.ПолучитьБлок(9, 1, 4) = 2, "W02: вода пруда");
Проверить(Мир.ПолучитьБлок(3, 5, 11) = 3, "W02: ствол дерева");
Проверить(Мир.ПолучитьБлок(3, 6, 11) = 3, "W02: верх дерева");
Проверить(Мир.ПолучитьБлок(8, 7, 8) = 0, "W02: пустая клетка");

Проверить(Мир.ВГраницах(0, 0, 0), "Нижняя граница должна входить в мир");
Проверить(Мир.ВГраницах(15, 7, 15), "Верхняя граница должна входить в мир");
Проверить(Не Мир.ВГраницах(-1, 0, 0), "Отрицательная координата вне мира");
Проверить(Не Мир.ВГраницах(16, 0, 0), "X=16 вне мира");
Проверить(Не Мир.ВГраницах(0, 8, 0), "Y=8 вне мира");
Проверить(Не Мир.ВГраницах(0, 0, 16), "Z=16 вне мира");
Проверить(Не Мир.ВГраницах(0.5, 0, 0), "Дробная координата не является клеткой мира");

Мир.Очистить();
НачальнаяВерсия = Мир.Версия;
Проверить(Мир.УстановитьБлок(1, 2, 3, 1), "W03: первая ячейка должна установиться");
Проверить(Мир.УстановитьБлок(2, 2, 3, 3), "W03: соседняя ячейка должна установиться");
Проверить(Мир.УстановитьБлок(1, 2, 4, 2), "W03: координата Z должна адресовать отдельную ячейку");
Проверить(Мир.УстановитьБлок(1, 3, 3, 2), "W03: координата Y должна адресовать отдельную ячейку");
Проверить(Мир.ПолучитьБлок(1, 2, 3) = 1, "W03: ID первой ячейки");
Проверить(Мир.ПолучитьБлок(2, 2, 3) = 3, "W03: ID соседней ячейки");
Проверить(Мир.ПолучитьБлок(1, 2, 4) = 2, "W03: ID ячейки с другим Z");
Проверить(Мир.ПолучитьБлок(1, 3, 3) = 2, "W03: ID ячейки с другим Y");
Проверить(Мир.ПолучитьБлок(1, 2, 5) = 0, "W03: другие клетки не перезаписаны");
Проверить(Мир.Версия = НачальнаяВерсия + 4, "Каждая успешная запись увеличивает версию на один");

Мир.Очистить();
Проверить(Мир.УстановитьБлок(0, 0, 0, 1), "W04: нулевая ячейка должна установиться");
Проверить(Мир.УстановитьБлок(15, 7, 15, 3), "W04: последняя ячейка должна установиться");
Проверить(Мир.ПолучитьБлок(0, 0, 0) = 1, "W04: ID ячейки с индексом 0");
Проверить(Мир.ПолучитьБлок(15, 7, 15) = 3, "W04: ID ячейки с индексом 2047");

Проверить(Мир.ПолучитьБлок(-1, 0, 0) = 0, "W05: чтение за минимальной границей X");
Проверить(Мир.ПолучитьБлок(16, 0, 0) = 0, "W05: чтение за максимальной границей X");
Проверить(Мир.ПолучитьБлок(0, -1, 0) = 0, "W05: чтение за минимальной границей Y");
Проверить(Мир.ПолучитьБлок(0, 8, 0) = 0, "W05: чтение за максимальной границей Y");
Проверить(Мир.ПолучитьБлок(0, 0, -1) = 0, "W05: чтение за минимальной границей Z");
Проверить(Мир.ПолучитьБлок(0, 0, 16) = 0, "W05: чтение за максимальной границей Z");
Проверить(Мир.ПолучитьБлок(0.5, 0, 0) = 0, "W05: дробное чтение");

ВерсияДоОтказов = Мир.Версия;
Проверить(Не Мир.УстановитьБлок(-1, 0, 0, 1), "W06: запись ниже X должна быть отклонена");
Проверить(Не Мир.УстановитьБлок(16, 0, 0, 1), "W06: запись выше X должна быть отклонена");
Проверить(Не Мир.УстановитьБлок(0, -1, 0, 1), "W06: запись ниже Y должна быть отклонена");
Проверить(Не Мир.УстановитьБлок(0, 8, 0, 1), "W06: запись выше Y должна быть отклонена");
Проверить(Не Мир.УстановитьБлок(0, 0, -1, 1), "W06: запись ниже Z должна быть отклонена");
Проверить(Не Мир.УстановитьБлок(0, 0, 16, 1), "W06: запись выше Z должна быть отклонена");
Проверить(Не Мир.УстановитьБлок(0.5, 0, 0, 1), "W06: дробная координата записи должна быть отклонена");
Проверить(Мир.Версия = ВерсияДоОтказов, "W06: отказанные записи не меняют версию");
Проверить(Мир.ПолучитьБлок(0, 0, 0) = 1, "W06: отказанные записи не меняют мир");

Проверить(Не Мир.УстановитьБлок(1, 1, 1, -1), "W07: отрицательный тип должен быть отклонён");
Проверить(Не Мир.УстановитьБлок(1, 1, 1, 4), "W07: тип 4 должен быть отклонён");
Проверить(Не Мир.УстановитьБлок(1, 1, 1, 1.5), "W07: дробный тип должен быть отклонён");
Проверить(Мир.Версия = ВерсияДоОтказов, "W07: неверный тип не меняет версию");
Проверить(Мир.ПолучитьБлок(1, 1, 1) = 0, "W07: неверный тип не меняет клетку");

ВерсияДоЗаписи = Мир.Версия;
Проверить(Мир.УстановитьБлок(1, 1, 1, 1), "W08: новая запись успешна");
Проверить(Мир.Версия = ВерсияДоЗаписи + 1, "W08: успешная запись меняет версию один раз");
Проверить(Не Мир.УстановитьБлок(1, 1, 1, 1), "W08: запись прежнего ID не меняет клетку");
Проверить(Мир.Версия = ВерсияДоЗаписи + 1, "W08: запись прежнего ID не меняет версию");

ВерсияПередОчисткой = Мир.Версия;
Мир.Очистить();
ПроверитьКоличествоБлоков(Мир, 0, 0, 0, 2048);
Проверить(Мир.Версия = ВерсияПередОчисткой + 1, "W09: очистка меняет версию один раз");
Мир.Очистить();
Проверить(Мир.Версия = ВерсияПередОчисткой + 1, "W09: повторная очистка пустого мира не меняет версию");

Проверить(Мир.УстановитьБлок(3, 3, 3, 2), "W10: блок в пустом мире устанавливается");
Открытые = Мир.ОткрытыеБлоки();
Проверить(Открытые.Количество() = 1, "W10: одиночный блок открыт со всех сторон");
ОткрытыеПовторно = Мир.ОткрытыеБлоки();
Проверить(Открытые = ОткрытыеПовторно, "W10: чистый кэш не перестраивается при повторном чтении");
Блок = Открытые.Получить(0);
Проверить(Блок.X = 3 И Блок.Y = 3 И Блок.Z = 3 И Блок.Тип = 2,
    "W10: структура открытого блока содержит правильные координаты и тип");
Проверить(Мир.УстановитьБлок(3, 3, 4, 3), "W10: соседний блок добавлен");
ОткрытыеПослеИзменения = Мир.ОткрытыеБлоки();
Проверить(ОткрытыеПослеИзменения <> Открытые, "W10: изменение мира инвалидирует кэш");
Проверить(ОткрытыеПослеИзменения.Количество() = 2, "W10: после перестройки учтён соседний блок");

Мир.Очистить();
Для Y = 2 По 4 Цикл
    Для Z = 2 По 4 Цикл
        Для X = 2 По 4 Цикл
            Проверить(Мир.УстановитьБлок(X, Y, Z, 1), "W11: заполнение 3x3x3");
        КонецЦикла;
    КонецЦикла;
КонецЦикла;
Проверить(Мир.ОткрытыеБлоки().Количество() = 26, "W11: у полного куба 3x3x3 открыты 26 блоков");
Проверить(Мир.УстановитьБлок(3, 3, 3, 0), "W11: удаление центра 3x3x3");
Проверить(Мир.ОткрытыеБлоки().Количество() = 26, "W11: удаление центра не меняет число открытых блоков");

Мир.Очистить();
Для Y = 1 По 5 Цикл
    Для Z = 1 По 5 Цикл
        Для X = 1 По 5 Цикл
            Проверить(Мир.УстановитьБлок(X, Y, Z, 1), "W12: заполнение 5x5x5");
        КонецЦикла;
    КонецЦикла;
КонецЦикла;
Проверить(Мир.ОткрытыеБлоки().Количество() = 98, "W12: у полного куба 5x5x5 открыты 98 блоков");
Проверить(Мир.УстановитьБлок(3, 3, 3, 0), "W12: удаление центра 5x5x5");
Проверить(Мир.ОткрытыеБлоки().Количество() = 104, "W12: после удаления центра открыты 104 блока");

Мир.Очистить();
Для Y = 0 По 7 Цикл
    Для Z = 0 По 15 Цикл
        Для X = 0 По 15 Цикл
            Проверить(Мир.УстановитьБлок(X, Y, Z, 1), "W13: заполнение всего мира");
        КонецЦикла;
    КонецЦикла;
КонецЦикла;
Проверить(Мир.ОткрытыеБлоки().Количество() = 872, "W13: в полном мире открыты 872 целых куба");

Мир.Очистить();
ЧислоНепустых = 0;
Для Y = 0 По 7 Цикл
    Для Z = 0 По 15 Цикл
        Для X = 0 По 15 Цикл
            Если (X + Y + Z) % 2 = 0 Тогда
                Проверить(Мир.УстановитьБлок(X, Y, Z, 1), "W14: запись шахматной сетки");
                ЧислоНепустых = ЧислоНепустых + 1;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецЦикла;
Проверить(ЧислоНепустых = 1024, "W14: шахматная сетка содержит 1024 блока");
Проверить(Мир.ОткрытыеБлоки().Количество() = 1024, "W14: каждый блок шахматной сетки открыт");

МирПервый = Новый Мир();
МирВторой = Новый Мир();
Для Y = 0 По 7 Цикл
    Для Z = 0 По 15 Цикл
        Для X = 0 По 15 Цикл
            Проверить(МирПервый.ПолучитьБлок(X, Y, Z) = МирВторой.ПолучитьБлок(X, Y, Z),
                "W15: сцена воспроизводится детерминированно");
        КонецЦикла;
    КонецЦикла;
КонецЦикла;

Сообщить("World: OK");
