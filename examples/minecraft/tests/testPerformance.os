#Использовать ".."

Перем Рейлиб;
Перем Фон;

Процедура БыстроСортировать(Значения, ЛеваяГраница, ПраваяГраница)
    Если ЛеваяГраница >= ПраваяГраница Тогда
        Возврат;
    КонецЕсли;

    Левый = ЛеваяГраница;
    Правый = ПраваяГраница;
    Опорное = Значения.Получить(Цел((ЛеваяГраница + ПраваяГраница) / 2));

    Пока Левый <= Правый Цикл
        Пока Значения.Получить(Левый) < Опорное Цикл
            Левый = Левый + 1;
        КонецЦикла;
        Пока Значения.Получить(Правый) > Опорное Цикл
            Правый = Правый - 1;
        КонецЦикла;

        Если Левый <= Правый Тогда
            Временное = Значения.Получить(Левый);
            Значения.Установить(Левый, Значения.Получить(Правый));
            Значения.Установить(Правый, Временное);
            Левый = Левый + 1;
            Правый = Правый - 1;
        КонецЕсли;
    КонецЦикла;

    Если ЛеваяГраница < Правый Тогда
        БыстроСортировать(Значения, ЛеваяГраница, Правый);
    КонецЕсли;
    Если Левый < ПраваяГраница Тогда
        БыстроСортировать(Значения, Левый, ПраваяГраница);
    КонецЕсли;
КонецПроцедуры

Функция РассчитатьP95(Значения)
    Отсортированные = Новый Массив;
    Для Каждого Значение Из Значения Цикл
        Отсортированные.Добавить(Значение);
    КонецЦикла;

    ЧислоЗначений = Отсортированные.Количество();
    Если ЧислоЗначений = 0 Тогда
        ВызватьИсключение "Нельзя вычислить p95 для пустой выборки";
    КонецЕсли;
    БыстроСортировать(Отсортированные, 0, ЧислоЗначений - 1);

    ИндексP95 = Цел(0.95 * ЧислоЗначений);
    Если ИндексP95 < 0.95 * ЧислоЗначений Тогда
        ИндексP95 = ИндексP95 + 1;
    КонецЕсли;
    ИндексP95 = Макс(0, ИндексP95 - 1);
    Возврат Отсортированные.Получить(ИндексP95);
КонецФункции

Функция НарисоватьКадр(Мир, Камера, ПозицияИгрока, Время)
    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Фон);
    Рейлиб.НачатьРежим3D(Камера);
    ЧислоКубов = Отрисовка.Нарисовать(Рейлиб, Мир, ПозицияИгрока, Время);
    Рейлиб.ЗакончитьРежим3D();
    Рейлиб.ЗакончитьОтрисовку();
    Возврат ЧислоКубов;
КонецФункции

Процедура ЗамеритьПрофиль(ИмяПрофиля, Мир, Камера, ПозицияИгрока)
    Отрисовка.Синхронизировать(Рейлиб, Мир);

    НачалоПрогрева = Рейлиб.ВремяРаботы();
    Пока Рейлиб.ВремяРаботы() - НачалоПрогрева < 5 Цикл
        НарисоватьКадр(Мир, Камера, ПозицияИгрока, Рейлиб.ВремяРаботы());
    КонецЦикла;

    Дельты = Новый Массив;
    СуммаДельт = 0;
    КадровДольше100мс = 0;
    МинимумКубов = -1;
    МаксимумКубов = 0;
    НачалоСбора = Рейлиб.ВремяРаботы();
    Пока Рейлиб.ВремяРаботы() - НачалоСбора < 30 Цикл
        НарисованныхКубов = НарисоватьКадр(Мир, Камера, ПозицияИгрока, Рейлиб.ВремяРаботы());
        Дельта = Рейлиб.ВремяКадра();
        Дельты.Добавить(Дельта);
        СуммаДельт = СуммаДельт + Дельта;

        Если Дельта > 0.1 Тогда
            КадровДольше100мс = КадровДольше100мс + 1;
        КонецЕсли;
        Если МинимумКубов < 0 Или НарисованныхКубов < МинимумКубов Тогда
            МинимумКубов = НарисованныхКубов;
        КонецЕсли;
        Если НарисованныхКубов > МаксимумКубов Тогда
            МаксимумКубов = НарисованныхКубов;
        КонецЕсли;
    КонецЦикла;

    ЧислоКадров = Дельты.Количество();
    Если ЧислоКадров = 0 Или СуммаДельт <= 0 Тогда
        ВызватьИсключение "Профиль " + ИмяПрофиля + " не собрал корректное время кадров";
    КонецЕсли;

    СреднееМс = 1000 * СуммаДельт / ЧислоКадров;
    СреднийFPS = ЧислоКадров / СуммаДельт;
    P95Мс = 1000 * РассчитатьP95(Дельты);

    Сообщить(ИмяПрофиля + ";" + Строка(ЧислоКадров) + ";"
        + Строка(СреднееМс) + ";" + Строка(СреднийFPS) + ";"
        + Строка(P95Мс) + ";" + Строка(КадровДольше100мс) + ";"
        + Строка(МинимумКубов) + ";" + Строка(МаксимумКубов) + ";"
        + Строка(Рейлиб.ШиринаЭкрана()) + "x" + Строка(Рейлиб.ВысотаЭкрана()) + ";"
        + Строка(Рейлиб.ШиринаРендера()) + "x" + Строка(Рейлиб.ВысотаРендера()));
КонецПроцедуры

ПроверочныеДельты = Новый Массив;
Для ИндексПроверки = 0 По 19 Цикл
    ПроверочныеДельты.Добавить(20 - ИндексПроверки);
КонецЦикла;
Если РассчитатьP95(ПроверочныеДельты) <> 19 Тогда
    ВызватьИсключение "p95 для 20 значений должен выбрать 19-й элемент после сортировки";
КонецЕсли;
Если ПроверочныеДельты.Получить(0) <> 20 Тогда
    ВызватьИсключение "Расчёт p95 не должен менять исходную выборку";
КонецЕсли;

КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "../../../src/raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.УстановитьФлагиКонфигурации(4); // FLAG_WINDOW_RESIZABLE
Рейлиб.ИнициализацияОкна("Minecraft renderer - performance profiles", 960, 540);
Рейлиб.УстановитьЧастотуКадров(0); // Не ограничивать FPS во время замера.

Если Рейлиб.ШиринаРендера() <= 0 Или Рейлиб.ВысотаРендера() <= 0 Тогда
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Окно создалось с нулевым render size";
КонецЕсли;

Фон = Рейлиб.НовыйЦвет(24, 31, 46, 255);
Мир = Новый Мир();
Если Мир.ОткрытыеБлоки().Количество() = 0 Тогда
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Начальная сцена не содержит открытых блоков";
КонецЕсли;

Позиция = Рейлиб.НовыйВектор3(8, 6, 14);
Цель = Рейлиб.НовыйВектор3(8, 5.658, 13.06);
Камера = Рейлиб.НоваяКамера3D(Позиция, Цель, Рейлиб.НовыйВектор3(0, 1, 0), 70, 0);
ПозицияИгрока = Новый Структура("X,Y,Z", 8, 6, 14);

Попытка
    Отрисовка.Инициализировать(Рейлиб, Мир);
Исключение
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Не удалось инициализировать shader для performance test";
КонецПопытки;

Сообщить("Профиль;Кадров;Среднее_мс;Среднее_FPS;p95_мс;Кадров_>100мс;Кубы_min;Кубы_max;Окно;Рендер");
ЗамеритьПрофиль("initial", Мир, Камера, ПозицияИгрока);

ИзмененоБлоков = 0;
Для Z = 0 По 4 Цикл
    Для X = 0 По 9 Цикл
        Если Мир.УстановитьБлок(X, 1, Z, 0) Тогда
            ИзмененоБлоков = ИзмененоБлоков + 1;
        КонецЕсли;
    КонецЦикла;
КонецЦикла;
Для Z = 0 По 4 Цикл
    Для X = 0 По 9 Цикл
        Если Мир.УстановитьБлок(X, 7, Z, 3) Тогда
            ИзмененоБлоков = ИзмененоБлоков + 1;
        КонецЕсли;
    КонецЦикла;
КонецЦикла;
Если ИзмененоБлоков <> 100 Тогда
    Отрисовка.Завершить(Рейлиб);
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Сценарий второго профиля должен выполнить ровно 100 успешных записей";
КонецЕсли;
ЗамеритьПрофиль("after-100-edits", Мир, Камера, ПозицияИгрока);

Мир.Очистить();
Для Y = 0 По 7 Цикл
    Для Z = 0 По 15 Цикл
        Для X = 0 По 15 Цикл
            Если (X + Y + Z) % 2 = 0 Тогда
                Мир.УстановитьБлок(X, Y, Z, 1);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецЦикла;
Если Мир.ОткрытыеБлоки().Количество() <> 1024 Тогда
    Отрисовка.Завершить(Рейлиб);
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Стресс-профиль должен содержать 1024 открытых куба";
КонецЕсли;
ЗамеритьПрофиль("checkerboard", Мир, Камера, ПозицияИгрока);

Отрисовка.Завершить(Рейлиб);
Рейлиб.ЗакрытьОкно();
Сообщить("Performance profiles: DONE");
