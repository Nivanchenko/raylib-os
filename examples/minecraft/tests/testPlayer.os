#Использовать ".."

Процедура Проверить(Условие, Сообщение)
    Если Не Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЧисло(Факт, Ожидание, Сообщение)
    Проверить(Макс(Факт - Ожидание, Ожидание - Факт) <= 0.000001, Сообщение);
КонецПроцедуры

Функция ДлинаВектора(Вектор)
    Возврат Sqrt(Вектор.X * Вектор.X + Вектор.Y * Вектор.Y + Вектор.Z * Вектор.Z);
КонецФункции

Процедура ПроверитьСкорость(ЧислоШагов)
    Игрок = Новый Игрок(0, 0, 0, 0, 0);
    Для Кадр = 1 По ЧислоШагов Цикл
        Игрок.Переместить(1, 0, 0, 1 / ЧислоШагов);
    КонецЦикла;

    Позиция = Игрок.Позиция();
    ПроверитьЧисло(Позиция.X, 0, "C11: скорость не должна зависеть от числа кадров, X");
    ПроверитьЧисло(Позиция.Y, 0, "C11: скорость не должна зависеть от числа кадров, Y");
    ПроверитьЧисло(Позиция.Z, -4, "C11: за секунду пройдено 4 единицы");
КонецПроцедуры

Пи = 3.141592653589793;

// C01: начальные координаты и взгляд вниз под углом 20 градусов.
Игрок = Новый Игрок();
Позиция = Игрок.Позиция();
Направление = Игрок.Направление();
ПроверитьЧисло(Позиция.X, 8, "C01: начальная позиция X");
ПроверитьЧисло(Позиция.Y, 6, "C01: начальная позиция Y");
ПроверитьЧисло(Позиция.Z, 14, "C01: начальная позиция Z");
ПроверитьЧисло(Направление.X, 0, "C01: направление X");
ПроверитьЧисло(Направление.Y, -0.3420201433, "C01: направление Y");
ПроверитьЧисло(Направление.Z, -0.9396926208, "C01: направление Z");

// C02: нулевые углы дают единичное направление -Z.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Направление = Игрок.Направление();
ПроверитьЧисло(Направление.X, 0, "C02: направление X при нулевых углах");
ПроверитьЧисло(Направление.Y, 0, "C02: направление Y при нулевых углах");
ПроверитьЧисло(Направление.Z, -1, "C02: направление -Z при нулевых углах");
ПроверитьЧисло(ДлинаВектора(Направление), 1, "C02: длина направления равна 1");

// C03: поворот yaw на +90 градусов направляет вперёд по +X.
Игрок.Повернуть((Пи / 2) / 0.0025, 0);
Направление = Игрок.Направление();
ПроверитьЧисло(Направление.X, 1, "C03: направление +X после поворота");
ПроверитьЧисло(Направление.Y, 0, "C03: поворот yaw не меняет Y");
ПроверитьЧисло(Направление.Z, 0, "C03: направление Z после поворота");

// C04–C05: pitch ограничен ±85 градусов.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Повернуть(0, -100000);
Направление = Игрок.Направление();
Углы = Игрок.Углы();
ПроверитьЧисло(Углы.Pitch, 85 * Пи / 180, "C04: pitch ограничен +85°");
ПроверитьЧисло(Направление.Y, 0.9961946981, "C04: направление Y при +85°");

Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Повернуть(0, 100000);
Направление = Игрок.Направление();
Углы = Игрок.Углы();
ПроверитьЧисло(Углы.Pitch, -85 * Пи / 180, "C05: pitch ограничен -85°");
ПроверитьЧисло(Направление.Y, -0.9961946981, "C05: направление Y при -85°");

// C06: yaw после нескольких оборотов остаётся в диапазоне ±π.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Повернуть((4 * Пи) / 0.0025, 0);
Углы = Игрок.Углы();
Направление = Игрок.Направление();
Проверить(Углы.Yaw >= -Пи И Углы.Yaw <= Пи, "C06: yaw обёрнут в диапазон ±π");
ПроверитьЧисло(Направление.X, 0, "C06: направление X после полного оборота");
ПроверитьЧисло(Направление.Y, 0, "C06: направление Y после полного оборота");
ПроверитьЧисло(Направление.Z, -1, "C06: направление -Z после полного оборота");

// C07: нулевой ввод не меняет позицию.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Переместить(0, 0, 0, 1 / 60);
Позиция = Игрок.Позиция();
Проверить(Позиция.X = 0 И Позиция.Y = 0 И Позиция.Z = 0, "C07: нулевой ввод оставляет игрока на месте");

// C08: один шаг вперёд при yaw=0.
Игрок.Переместить(1, 0, 0, 0.05);
Позиция = Игрок.Позиция();
ПроверитьЧисло(Позиция.X, 0, "C08: полёт вперёд не меняет X");
ПроверитьЧисло(Позиция.Y, 0, "C08: полёт вперёд не меняет Y");
ПроверитьЧисло(Позиция.Z, -0.2, "C08: полёт вперёд на 0.2");

// C09: диагональ по горизонтали нормализуется.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Переместить(1, 1, 0, 0.05);
Позиция = Игрок.Позиция();
ПроверитьЧисло(Позиция.X, 0.1414213562, "C09: диагональное перемещение X");
ПроверитьЧисло(Позиция.Y, 0, "C09: диагональный полёт по земле не меняет Y");
ПроверитьЧисло(Позиция.Z, -0.1414213562, "C09: диагональное перемещение Z");
ПроверитьЧисло(ДлинаВектора(Позиция), 0.2, "C09: горизонтальная диагональ имеет длину 0.2");

// C10: нормализуется также диагональ с вертикальной осью.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Переместить(1, 1, 1, 0.05);
Позиция = Игрок.Позиция();
ПроверитьЧисло(ДлинаВектора(Позиция), 0.2, "C10: пространственная диагональ имеет длину 0.2");

// C11: одинаковая скорость при 30, 60 и 120 шагах за секунду.
ПроверитьСкорость(30);
ПроверитьСкорость(60);
ПроверитьСкорость(120);

// C12: большой dt ограничен 0.05, отрицательный dt заменяется нулём.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Переместить(1, 0, 0, 0.5);
Позиция = Игрок.Позиция();
ПроверитьЧисло(Позиция.Z, -0.2, "C12: большой dt ограничен 0.05");
Игрок.Переместить(1, 0, 0, -1);
ПозицияПослеОтрицательногоDt = Игрок.Позиция();
ПроверитьЧисло(ПозицияПослеОтрицательногоDt.Z, Позиция.Z, "C12: отрицательный dt не перемещает игрока");

// C13: вертикальный обзор не наклоняет горизонтальный полёт.
Игрок = Новый Игрок(0, 0, 0, 0, 0);
Игрок.Повернуть(0, -100000);
Игрок.Переместить(1, 0, 0, 0.05);
Позиция = Игрок.Позиция();
ПроверитьЧисло(Позиция.Y, 0, "C13: полёт вперёд при взгляде вверх не меняет Y");
ПроверитьЧисло(Позиция.Z, -0.2, "C13: полёт вперёд остаётся горизонтальным");

// C14: геттер позиции возвращает независимую структуру.
Игрок = Новый Игрок(2, 3, 4, 0, 0);
ПозицияКопия = Игрок.Позиция();
ПозицияКопия.X = 999;
Позиция = Игрок.Позиция();
ПроверитьЧисло(Позиция.X, 2, "C14: изменение выданной структуры не меняет игрока");

Сообщить("Player: OK");
