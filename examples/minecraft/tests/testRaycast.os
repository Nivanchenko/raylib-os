#Использовать ".."

Процедура Проверить(Условие, Сообщение)
    Если Не Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЧисло(Факт, Ожидание, Сообщение)
    Если Макс(Факт - Ожидание, Ожидание - Факт) > 0.000001 Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПопадание(Результат, X, Y, Z, NX, NY, NZ, Расстояние, Сообщение)
    Проверить(Результат.Попадание, Сообщение + ": флаг попадания");
    Проверить(Результат.X = X И Результат.Y = Y И Результат.Z = Z,
        Сообщение + ": координаты клетки");
    Проверить(Результат.NX = NX И Результат.NY = NY И Результат.NZ = NZ,
        Сообщение + ": нормаль");
    ПроверитьЧисло(Результат.Расстояние, Расстояние, Сообщение + ": расстояние");
КонецПроцедуры

Процедура ПроверитьПромах(Результат, Сообщение)
    Проверить(Не Результат.Попадание, Сообщение + ": флаг промаха");
    Проверить(
        Результат.X = 0 И Результат.Y = 0 И Результат.Z = 0
            И Результат.NX = 0 И Результат.NY = 0 И Результат.NZ = 0
            И Результат.Расстояние = 0,
        Сообщение + ": поля промаха должны быть нулевыми");
КонецПроцедуры

Функция НовыйПустойМир()
    Результат = Новый Мир();
    Результат.Очистить();
    Возврат Результат;
КонецФункции

Мир = НовыйПустойМир();
Мир.УстановитьБлок(2, 2, 2, 1);

// R01: контрольный пример и вход с отрицательной X-нормалью.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, -1, 0, 0, 1.5, "R01");

// R02: вход с противоположной стороны по X.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 4.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", -1, 0, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, 1, 0, 0, 1.5, "R02");

// R03–R06: обе стороны каждой из трёх осей.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2.5, 0.5, 2.5),
    Новый Структура("X,Y,Z", 0, 1, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, 0, -1, 0, 1.5, "R03");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2.5, 4.5, 2.5),
    Новый Структура("X,Y,Z", 0, -1, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, 0, 1, 0, 1.5, "R04");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2.5, 2.5, 0.5),
    Новый Структура("X,Y,Z", 0, 0, 1), 5);
ПроверитьПопадание(Результат, 2, 2, 2, 0, 0, -1, 1.5, "R05");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2.5, 2.5, 4.5),
    Новый Структура("X,Y,Z", 0, 0, -1), 5);
ПроверитьПопадание(Результат, 2, 2, 2, 0, 0, 1, 1.5, "R06");

// R07: длина D не меняет мировую дальность.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 10, 0, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, -1, 0, 0, 1.5, "R07");

// R08: вода непрозрачна и заслоняет землю.
Мир.УстановитьБлок(1, 2, 2, 2);
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПопадание(Результат, 1, 2, 2, -1, 0, 0, 0.5, "R08");
Мир.УстановитьБлок(1, 2, 2, 0);

// R09–R10: дальность 5 включена, 5.001 уже за пределом.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", -3, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, -1, 0, 0, 5, "R09");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", -3.001, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПромах(Результат, "R10");

// R11–R12: луч назад и параллельный луч снаружи мира.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", -1, 2.5, 2.5),
    Новый Структура("X,Y,Z", -1, 0, 0), 5);
ПроверитьПромах(Результат, "R11");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", -1, 2.5, 2.5),
    Новый Структура("X,Y,Z", 0, 0, 1), 5);
ПроверитьПромах(Результат, "R12");

// R13–R14: старт в блоке и нулевой вектор всегда дают промах.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПромах(Результат, "R13");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 0, 0, 0), 5);
ПроверитьПромах(Результат, "R14");

// R15–R16: точное касание ребра/угла шагает сразу по совпавшим осям.
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 1.5, 1.5, 2.5),
    Новый Структура("X,Y,Z", 1, 1, 0), 5);
ПроверитьПопадание(Результат, 2, 2, 2, -1, 0, 0, 0.7071067812, "R15");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 1.5, 1.5, 1.5),
    Новый Структура("X,Y,Z", 1, 1, 1), 5);
ПроверитьПопадание(Результат, 2, 2, 2, -1, 0, 0, 0.8660254038, "R16");

Мир = НовыйПустойМир();
Мир.УстановитьБлок(2, 1, 2, 1);
Мир.УстановитьБлок(1, 2, 2, 1);
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 1.5, 1.5, 2.5),
    Новый Структура("X,Y,Z", 1, 1, 0), 5);
ПроверитьПромах(Результат, "R17");

// R18: на границе вход в смежную клетку имеет нулевое расстояние.
Мир = НовыйПустойМир();
Мир.УстановитьБлок(1, 2, 2, 1);
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2, 2.5, 2.5),
    Новый Структура("X,Y,Z", -1, 0, 0), 5);
ПроверитьПопадание(Результат, 1, 2, 2, 1, 0, 0, 0, "R18");

// R19: floor(P) задаёт клетку камеры даже на целой границе.
Мир = НовыйПустойМир();
Мир.УстановитьБлок(2, 2, 2, 1);
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 2, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПромах(Результат, "R19");

// R20–R21: вход через внешнюю max-границу либо параллельный промах.
Мир = НовыйПустойМир();
Мир.УстановитьБлок(15, 2, 2, 1);
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 16.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", -1, 0, 0), 5);
ПроверитьПопадание(Результат, 15, 2, 2, 1, 0, 0, 0.5, "R20");

Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 16, 2.5, 2.5),
    Новый Структура("X,Y,Z", 0, 0, 1), 5);
ПроверитьПромах(Результат, "R21");

// R22–R23: пустой мир и нулевая дальность.
Мир = НовыйПустойМир();
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 5);
ПроверитьПромах(Результат, "R22");

Мир.УстановитьБлок(2, 2, 2, 1);
Результат = ВоксельныйЛуч.Трассировать(Мир,
    Новый Структура("X,Y,Z", 0.5, 2.5, 2.5),
    Новый Структура("X,Y,Z", 1, 0, 0), 0);
ПроверитьПромах(Результат, "R23");

Сообщить("Raycast: OK");
