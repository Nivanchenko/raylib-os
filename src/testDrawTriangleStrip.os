КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Raylibos DrawTriangleStrip Test", 800, 600);

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(200, 0, 0, 255);
Синий = Рейлиб.НовыйЦвет(0, 0, 200, 255);
Зеленый = Рейлиб.НовыйЦвет(0, 200, 0, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);

// Треугольная полоса - зигзаг из треугольников
ТочкиПолоса = Новый Массив;
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(100, 200)); // 0
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(150, 250)); // 1
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(200, 200)); // 2
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(250, 250)); // 3
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(300, 200)); // 4
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(350, 250)); // 5
ТочкиПолоса.Добавить(Рейлиб.НовыйВектор(400, 200)); // 6

// Вторая полоса - волна
ТочкиПолоса2 = Новый Массив;
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(100, 350));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(150, 400));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(200, 380));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(250, 420));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(300, 390));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(350, 430));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(400, 400));
ТочкиПолоса2.Добавить(Рейлиб.НовыйВектор(450, 440));

Рейлиб.УстановитьЧастотуКадров(60);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

	Рейлиб.НачатьОтрисовку();

	Рейлиб.ОчиститьФон(Белый);

	// Отрисовка треугольных полос
	Рейлиб.НарисоватьТреугольникПолоса(ТочкиПолоса, Зеленый);
	Рейлиб.НарисоватьТреугольникПолоса(ТочкиПолоса2, Синий);

	// Подписи
	Рейлиб.НарисоватьТекст("DrawTriangleStrip - triangle strip (connected triangles)", 180, 20, 16, Черный);
	Рейлиб.НарисоватьТекст("Each new vertex forms a triangle with previous two", 200, 45, 12, Черный);
	Рейлиб.НарисоватьТекст("Zigzag strip (green)", 100, 280, 12, Зеленый);
	Рейлиб.НарисоватьТекст("Wave strip (blue)", 100, 480, 12, Синий);

	Рейлиб.ПоказатьFPS();

	Рейлиб.ЗакончитьОтрисовку();

КонецЦикла;

Рейлиб.ЗакрытьОкно();
