КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

// Флаги конфигурации задаются до создания окна.
Рейлиб.УстановитьФлагиКонфигурации(4); // FLAG_WINDOW_RESIZABLE
Рейлиб.ИнициализацияОкна("Timing Test", 800, 600);
Рейлиб.УстановитьЧастотуКадров(60);

Рейлиб.УстановитьЗерноСлучайныхЧисел(4294967295);
ПервоеЧисло = Рейлиб.Случайное(0, 1000);
Рейлиб.УстановитьЗерноСлучайныхЧисел(4294967295);
Если ПервоеЧисло <> Рейлиб.Случайное(0, 1000) Тогда
    ВызватьИсключение "Одинаковое зерно должно давать одинаковую последовательность";
КонецЕсли;

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);
Начало = Рейлиб.ВремяРаботы();
Рейлиб.Подождать(0.02);
Если Рейлиб.ВремяРаботы() <= Начало Тогда
    ВызватьИсключение "Время должно увеличиваться после ожидания";
КонецЕсли;

Рейлиб.ОтключитьКурсор();
Рейлиб.ВключитьКурсор();
ПолученКадр = Ложь;
ПолученFPS = Ложь;

// Ограничение по времени позволяет запускать демо без ручного закрытия окна.
Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 5 Цикл
    ВремяКадра = Рейлиб.ВремяКадра();
    ВремяРаботы = Рейлиб.ВремяРаботы() - Начало;
    КадровВСекунду = Рейлиб.ТекущийFPS();
    Если ВремяКадра > 0 Тогда ПолученКадр = Истина; КонецЕсли;
    Если КадровВСекунду > 0 Тогда ПолученFPS = Истина; КонецЕсли;

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьТекст("Frame time (s): " + ВремяКадра, 20, 20, 20, Черный);
    Рейлиб.НарисоватьТекст("Time since start (s): " + ВремяРаботы, 20, 50, 20, Черный);
    Рейлиб.НарисоватьТекст("FPS: " + КадровВСекунду, 20, 80, 20, Черный);
    Рейлиб.НарисоватьТекст("Cursor on screen: " + Рейлиб.КурсорНаЭкране(), 20, 110, 20, Черный);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Рейлиб.ЗакрытьОкно();
Если Не ПолученКадр Или Не ПолученFPS Тогда
    ВызватьИсключение "Не удалось получить время кадра или FPS";
КонецЕсли;
