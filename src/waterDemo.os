КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

// Файлы шейдера ищутся относительно рабочего каталога — запускайте из корня репозитория.
Рейлиб.УстановитьФлагиКонфигурации(4); // FLAG_WINDOW_RESIZABLE
Рейлиб.ИнициализацияОкна("Water shader - hold left mouse button to make ripples", 960, 540);
Рейлиб.УстановитьЧастотуКадров(60);

Шейдер = Рейлиб.ЗагрузитьШейдер("resources/shaders/water.vs", "resources/shaders/water.fs");
Если Не Рейлиб.ШейдерГотов(Шейдер) Тогда
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Не удалось загрузить шейдер воды";
КонецЕсли;
Время = Рейлиб.ПозицияПараметраШейдера(Шейдер, "uTime");
Размер = Рейлиб.ПозицияПараметраШейдера(Шейдер, "uResolution");
Мышь = Рейлиб.ПозицияПараметраШейдера(Шейдер, "uMouse");
Рябь = Рейлиб.ПозицияПараметраШейдера(Шейдер, "uRipple");
// raylib может подставить стандартный шейдер, если GLSL не удалось скомпилировать.
Если Время < 0 Или Размер < 0 Или Мышь < 0 Или Рябь < 0 Тогда
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Шейдер воды не скомпилирован: проверьте лог SHADER и путь resources/shaders/";
КонецЕсли;

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Текст = Рейлиб.НовыйЦвет(238, 233, 219, 255);
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл
    Ширина = Рейлиб.ШиринаЭкрана();
    Высота = Рейлиб.ВысотаЭкрана();
    // Даже при свёрнутом окне продолжаем EndDrawing(), чтобы события обрабатывались.
    Если Ширина <= 0 Тогда Ширина = 1; КонецЕсли;
    Если Высота <= 0 Тогда Высота = 1; КонецЕсли;
    ШиринаРендера = Рейлиб.ШиринаРендера();
    ВысотаРендера = Рейлиб.ВысотаРендера();
    Если ШиринаРендера <= 0 Тогда ШиринаРендера = 1; КонецЕсли;
    Если ВысотаРендера <= 0 Тогда ВысотаРендера = 1; КонецЕсли;

    ПозицияМыши = Рейлиб.ПозицияМыши();
    Рейлиб.УстановитьЗначениеШейдераFloat(Шейдер, Время, Рейлиб.ВремяРаботы() - Начало);
    Рейлиб.УстановитьЗначениеШейдераVector2(Шейдер, Размер,
        Рейлиб.НовыйВектор(ШиринаРендера, ВысотаРендера));
    Рейлиб.УстановитьЗначениеШейдераVector2(Шейдер, Мышь,
        Рейлиб.НовыйВектор(Рейлиб.ВекторX(ПозицияМыши) / Ширина,
                            1 - Рейлиб.ВекторY(ПозицияМыши) / Высота));
    Если Рейлиб.КнопкаМышиЗажата(0) Тогда
        Рейлиб.УстановитьЗначениеШейдераFloat(Шейдер, Рябь, 1);
    Иначе
        Рейлиб.УстановитьЗначениеШейдераFloat(Шейдер, Рябь, 0);
    КонецЕсли;

    Рейлиб.НачатьОтрисовку();
    Рейлиб.НачатьРежимШейдера(Шейдер);
    Рейлиб.НарисоватьПрямоугольник(0, 0, Ширина, Высота, Белый);
    Рейлиб.ЗакончитьРежимШейдера();
    Рейлиб.НарисоватьТекст("HOLD LEFT MOUSE BUTTON OVER WATER - RIPPLES", 20, 20, 16, Текст);
    Рейлиб.НарисоватьТекст("ESC - CLOSE  |  RESIZE THE WINDOW", 20, 44, 16, Текст);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Рейлиб.ВыгрузитьШейдер(Шейдер);
Рейлиб.ЗакрытьОкно();
