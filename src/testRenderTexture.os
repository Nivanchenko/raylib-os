КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Render Texture Test", 480, 320);
Рейлиб.УстановитьЧастотуКадров(60);
Цель = Рейлиб.ЗагрузитьТекстуруРендера(240, 160);
Если Не Рейлиб.ТекстураРендераГотова(Цель) Тогда
    ВызватьИсключение "Render texture не создана";
КонецЕсли;
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(255, 0, 0, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);
Текстура = Рейлиб.ЦветоваяТекстураРендера(Цель);
Источник = Рейлиб.НовыйПрямоугольник(0, 0, 240, -160); // Y перевёрнут в render texture
Назначение = Рейлиб.НовыйПрямоугольник(0, 0, 480, 320);
Начало = Рейлиб.НовыйВектор(0, 0);
НачалоВремени = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - НачалоВремени < 3 Цикл
    Рейлиб.НачатьРисованиеВТекстуру(Цель);
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьКруг(120, 80, 35, Красный);
    Рейлиб.ЗакончитьРисованиеВТекстуру();

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Черный);
    Рейлиб.НачатьОбрезку(0, 0, 480, 320);
    Рейлиб.НачатьРежимСмешивания(0); // BLEND_ALPHA
    Рейлиб.НарисоватьТекстуруПро(Текстура, Источник, Назначение, Начало, 0, Белый);
    Рейлиб.ЗакончитьРежимСмешивания();
    Рейлиб.ЗакончитьОбрезку();
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

// Цветовой буфер принадлежит Цели: отдельно ВыгрузитьТекстуру(Текстура) НЕ вызываем.
Рейлиб.ВыгрузитьТекстуруРендера(Цель);
Рейлиб.ЗакрытьОкно();
