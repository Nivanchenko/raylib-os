КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Центр1 = Рейлиб.НовыйВектор3(0, 0, 0);
Центр2 = Рейлиб.НовыйВектор3(1, 0, 0);
Далеко = Рейлиб.НовыйВектор3(5, 0, 0);
Если Не Рейлиб.ПересекаютсяСферы(Центр1, 1, Центр2, 1)
    Или Рейлиб.ПересекаютсяСферы(Центр1, 1, Далеко, 1) Тогда
    ВызватьИсключение "Неверная коллизия сфер";
КонецЕсли;

Бокс1 = Рейлиб.НовыйОграничивающийБокс(Рейлиб.НовыйВектор3(-1, -1, -1), Рейлиб.НовыйВектор3(1, 1, 1));
Бокс2 = Рейлиб.НовыйОграничивающийБокс(Рейлиб.НовыйВектор3(0, -1, -1), Рейлиб.НовыйВектор3(2, 1, 1));
БоксДалеко = Рейлиб.НовыйОграничивающийБокс(Рейлиб.НовыйВектор3(4, -1, -1), Рейлиб.НовыйВектор3(6, 1, 1));
Если Не Рейлиб.ПересекаютсяБоксы(Бокс1, Бокс2)
    Или Рейлиб.ПересекаютсяБоксы(Бокс1, БоксДалеко) Тогда
    ВызватьИсключение "Неверная коллизия боксов";
КонецЕсли;

Рейлиб.ИнициализацияОкна("3D Collisions", 480, 320);
Рейлиб.УстановитьЧастотуКадров(60);
Камера = Рейлиб.НоваяКамера3D(Рейлиб.НовыйВектор3(6, 5, 7), Центр1, Рейлиб.НовыйВектор3(0, 1, 0), 45, 0);
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(220, 50, 50, 255);
Синий = Рейлиб.НовыйЦвет(40, 80, 220, 255);
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 2 Цикл
    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НачатьРежим3D(Камера);
    Рейлиб.НарисоватьОграничивающийБокс(Бокс1, Синий);
    Рейлиб.НарисоватьОграничивающийБокс(Бокс2, Красный);
    Рейлиб.НарисоватьОграничивающийБокс(БоксДалеко, Синий);
    Рейлиб.НарисоватьСферу(Центр1, 0.4, Синий);
    Рейлиб.НарисоватьСферу(Центр2, 0.4, Красный);
    Рейлиб.ЗакончитьРежим3D();
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;
Рейлиб.ЗакрытьОкно();
