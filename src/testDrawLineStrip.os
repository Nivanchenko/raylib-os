КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Raylibos DrawLineStrip Test", 800, 600);

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(200, 0, 0, 255);
Синий = Рейлиб.НовыйЦвет(0, 0, 200, 255);
Зеленый = Рейлиб.НовыйЦвет(0, 200, 0, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);

// Создание массива точек для линии
Точки1 = Новый Массив;
Точки1.Добавить(Рейлиб.НовыйВектор(100, 100));
Точки1.Добавить(Рейлиб.НовыйВектор(150, 150));
Точки1.Добавить(Рейлиб.НовыйВектор(200, 100));
Точки1.Добавить(Рейлиб.НовыйВектор(250, 150));
Точки1.Добавить(Рейлиб.НовыйВектор(300, 100));

// Вторая линия - зигзаг
Точки2 = Новый Массив;
Точки2.Добавить(Рейлиб.НовыйВектор(400, 200));
Точки2.Добавить(Рейлиб.НовыйВектор(450, 250));
Точки2.Добавить(Рейлиб.НовыйВектор(500, 200));
Точки2.Добавить(Рейлиб.НовыйВектор(550, 250));
Точки2.Добавить(Рейлиб.НовыйВектор(600, 200));
Точки2.Добавить(Рейлиб.НовыйВектор(650, 250));

// Третья линия - волна
Точки3 = Новый Массив;
Точки3.Добавить(Рейлиб.НовыйВектор(100, 450));
Точки3.Добавить(Рейлиб.НовыйВектор(150, 430));
Точки3.Добавить(Рейлиб.НовыйВектор(200, 450));
Точки3.Добавить(Рейлиб.НовыйВектор(250, 470));
Точки3.Добавить(Рейлиб.НовыйВектор(300, 450));
Точки3.Добавить(Рейлиб.НовыйВектор(350, 430));
Точки3.Добавить(Рейлиб.НовыйВектор(400, 450));
Точки3.Добавить(Рейлиб.НовыйВектор(450, 470));
Точки3.Добавить(Рейлиб.НовыйВектор(500, 450));
Точки3.Добавить(Рейлиб.НовыйВектор(550, 430));
Точки3.Добавить(Рейлиб.НовыйВектор(600, 450));

Рейлиб.УстановитьЧастотуКадров(60);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

	Рейлиб.НачатьОтрисовку();

	Рейлиб.ОчиститьФон(Белый);

	// Отрисовка первой линии (зигзаг)
	Рейлиб.НарисоватьЛинииПолоса(Точки1, Красный);

	// Отрисовка второй линии (спираль)
	Рейлиб.НарисоватьЛинииПолоса(Точки2, Синий);

	// Отрисовка третьей линии (синусоида)
	Рейлиб.НарисоватьЛинииПолоса(Точки3, Зеленый);

	// Подписи
	Рейлиб.НарисоватьТекст("DrawLineStrip - connected lines sequence", 250, 20, 16, Черный);
	Рейлиб.НарисоватьТекст("Zigzag (red)", 100, 80, 12, Красный);
	Рейлиб.НарисоватьТекст("Zigzag 2 (blue)", 450, 150, 12, Синий);
	Рейлиб.НарисоватьТекст("Wave (green)", 100, 520, 12, Зеленый);

	Рейлиб.ПоказатьFPS();

	Рейлиб.ЗакончитьОтрисовку();

КонецЦикла;

Рейлиб.ЗакрытьОкно();
