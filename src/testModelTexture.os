КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Raylibos Model Loading", 800, 450);

// Определение камеры
Позиция = Рейлиб.НовыйВектор3(50, 50, 50);
Цель = Рейлиб.НовыйВектор3(0, 12, 0);
Вверх = Рейлиб.НовыйВектор3(0, 1, 0);
Камера = Рейлиб.НоваяКамера3D(Позиция, Цель, Вверх, 45, 0); // 0 = CAMERA_PERSPECTIVE

// Загрузка модели и текстуры
Модель = Рейлиб.ЗагрузитьМодель("resources/castle.obj");
Текстура = Рейлиб.ЗагрузитьТекстуру("resources/castle_diffuse.png");

// Установка текстуры модели
Рейлиб.УстановитьТекстуруМодели(Модель, Текстура);

ПозицияМодели = Рейлиб.НовыйВектор3(0, 0, 0);

// Получение ограничивающего бокса
Бокс = Рейлиб.ПолучитьОграничивающийБокс(Модель);

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Зеленый = Рейлиб.НовыйЦвет(0, 255, 0, 255);
ТемноСерый = Рейлиб.НовыйЦвет(64, 64, 64, 255);

Рейлиб.УстановитьЧастотуКадров(60);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

	Рейлиб.НачатьОтрисовку();

	Рейлиб.ОчиститьФон(Белый);

	// Обновление камеры (орбитальная)
	Камера = Рейлиб.ОбновитьКамеру(Камера, 2); // CAMERA_ORBITAL

	Рейлиб.НачатьРежим3D(Камера);

		// Отрисовка модели
		Рейлиб.НарисоватьМодель(Модель, ПозицияМодели, 1.0, Белый);

		// Отрисовка сетки
		Рейлиб.НарисоватьСетку(20, 10.0);

		// Отрисовка ограничивающего бокса
		Рейлиб.НарисоватьОграничивающийБокс(Бокс, Зеленый);

	Рейлиб.ЗакончитьРежим3D();

	Рейлиб.НарисоватьТекст("Castle 3D model with texture", 10, 430, 10, ТемноСерый);
	Рейлиб.НарисоватьТекст("(c) Castle 3D model by Alberto Cano", 580, 430, 10, ТемноСерый);

	Рейлиб.ЗакончитьОтрисовку();

КонецЦикла;

// Выгрузка ресурсов
Рейлиб.ВыгрузитьТекстуру(Текстура);
Рейлиб.ВыгрузитьМодель(Модель);

Рейлиб.ЗакрытьОкно();
