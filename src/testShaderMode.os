КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Shader Test", 480, 320);
Рейлиб.УстановитьЧастотуКадров(60);
КодВершины = "#version 330" + Символы.ПС
    + "in vec3 vertexPosition;" + Символы.ПС
    + "in vec2 vertexTexCoord;" + Символы.ПС
    + "in vec4 vertexColor;" + Символы.ПС
    + "out vec2 fragTexCoord;" + Символы.ПС
    + "out vec4 fragColor;" + Символы.ПС
    + "uniform mat4 mvp;" + Символы.ПС
    + "void main() { fragTexCoord = vertexTexCoord; fragColor = vertexColor; gl_Position = mvp * vec4(vertexPosition, 1.0); }";
КодФрагмента = "#version 330" + Символы.ПС
    + "in vec2 fragTexCoord;" + Символы.ПС
    + "in vec4 fragColor;" + Символы.ПС
    + "out vec4 finalColor;" + Символы.ПС
    + "uniform sampler2D texture0;" + Символы.ПС
    + "uniform vec4 colDiffuse;" + Символы.ПС
    + "uniform float intensity;" + Символы.ПС
    + "uniform int enabled;" + Символы.ПС
    + "uniform vec2 offset;" + Символы.ПС
    + "uniform vec3 tint;" + Символы.ПС
    + "uniform float weights[2];" + Символы.ПС
    + "void main() { finalColor = texture(texture0, fragTexCoord + offset) * colDiffuse * fragColor * intensity * float(enabled) * (weights[0] + weights[1]) * vec4(tint, 1.0); }";

Шейдер = Рейлиб.ЗагрузитьШейдерИзСтроки(КодВершины, КодФрагмента);
Если Не Рейлиб.ШейдерГотов(Шейдер) Тогда
    ВызватьИсключение "Шейдер не загрузился";
КонецЕсли;
Рейлиб.УстановитьЗначениеШейдераFloat(Шейдер, Рейлиб.ПозицияПараметраШейдера(Шейдер, "intensity"), 0.7);
Рейлиб.УстановитьЗначениеШейдераInt(Шейдер, Рейлиб.ПозицияПараметраШейдера(Шейдер, "enabled"), 1);
Рейлиб.УстановитьЗначениеШейдераVector2(Шейдер, Рейлиб.ПозицияПараметраШейдера(Шейдер, "offset"), Рейлиб.НовыйВектор(0, 0));
Рейлиб.УстановитьЗначениеШейдераVector3(Шейдер, Рейлиб.ПозицияПараметраШейдера(Шейдер, "tint"), Рейлиб.НовыйВектор3(1, 1, 1));
Веса = Новый Массив;
Веса.Добавить(0.5);
Веса.Добавить(0.5);
Рейлиб.УстановитьМассивШейдераFloat(Шейдер, Рейлиб.ПозицияПараметраШейдера(Шейдер, "weights[0]"), Веса);
Если Рейлиб.ПозицияАтрибутаШейдера(Шейдер, "vertexPosition") < 0 Тогда
    ВызватьИсключение "Атрибут vertexPosition не найден";
КонецЕсли;
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(255, 0, 0, 255);
НачалоВремени = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - НачалоВремени < 3 Цикл
    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НачатьРежимШейдера(Шейдер);
    Рейлиб.НарисоватьКруг(240, 160, 60, Красный);
    Рейлиб.ЗакончитьРежимШейдера();
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Рейлиб.ВыгрузитьШейдер(Шейдер);
Рейлиб.ЗакрытьОкно();
