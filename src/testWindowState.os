КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Window State Test", 800, 600);

FLAG_WINDOW_RESIZABLE = 4;
Рейлиб.УстановитьФлагиОкна(FLAG_WINDOW_RESIZABLE);

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

    Если Рейлиб.КлавишаНажата(70) Тогда // KEY_F — переключить полноэкранный режим
        Рейлиб.ПереключитьПолноэкранныйРежим();
    КонецЕсли;

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);

    Рейлиб.НарисоватьТекст("F - toggle fullscreen, resize the window with the mouse", 20, 20, 20, Черный);
    Рейлиб.НарисоватьТекст("GetScreenWidth/Height: " + Рейлиб.ШиринаЭкрана() + " x " + Рейлиб.ВысотаЭкрана(), 20, 50, 20, Черный);
    Рейлиб.НарисоватьТекст("GetRenderWidth/Height: " + Рейлиб.ШиринаРендера() + " x " + Рейлиб.ВысотаРендера(), 20, 80, 20, Черный);

    Если Рейлиб.ОкноПолноэкранное() Тогда
        Рейлиб.НарисоватьТекст("Fullscreen: yes", 20, 110, 20, Черный);
    Иначе
        Рейлиб.НарисоватьТекст("Fullscreen: no", 20, 110, 20, Черный);
    КонецЕсли;

    Позиция = Рейлиб.ПозицияОкна();
    Рейлиб.НарисоватьТекст("Window position: " + Рейлиб.ВекторX(Позиция) + ", " + Рейлиб.ВекторY(Позиция), 20, 140, 20, Черный);

    Рейлиб.ПоказатьFPS(20, 170);

    Рейлиб.ЗакончитьОтрисовку();

КонецЦикла;

Рейлиб.ЗакрытьОкно();
