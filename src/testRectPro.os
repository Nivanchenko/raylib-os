КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Raylibos DrawRectanglePro Test", 800, 600);

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(200, 0, 0, 255);
Синий = Рейлиб.НовыйЦвет(0, 0, 200, 255);
Зеленый = Рейлиб.НовыйЦвет(0, 200, 0, 255);
Желтый = Рейлиб.НовыйЦвет(200, 200, 0, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);

// Прямоугольник с центром в середине
Прямоугольник = Рейлиб.НовыйПрямоугольник(0, 0, 100, 60);
// Точка вращения - центр прямоугольника
Центр = Рейлиб.НовыйВектор(50, 30);

Угол = 0;

Рейлиб.УстановитьЧастотуКадров(60);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

	Рейлиб.НачатьОтрисовку();

	Рейлиб.ОчиститьФон(Белый);

	// Отрисовка прямоугольников с разным углом вращения
	Прямоугольник1 = Рейлиб.НовыйПрямоугольник(200, 150, 100, 60);
	Рейлиб.НарисоватьПрямоугольникПро(Прямоугольник1, Центр, Угол, Красный);

	Прямоугольник2 = Рейлиб.НовыйПрямоугольник(350, 150, 100, 60);
	Рейлиб.НарисоватьПрямоугольникПро(Прямоугольник2, Центр, Угол + 45, Синий);

	Прямоугольник3 = Рейлиб.НовыйПрямоугольник(500, 150, 100, 60);
	Рейлиб.НарисоватьПрямоугольникПро(Прямоугольник3, Центр, Угол + 90, Зеленый);

	Прямоугольник4 = Рейлиб.НовыйПрямоугольник(650, 150, 100, 60);
	Рейлиб.НарисоватьПрямоугольникПро(Прямоугольник4, Центр, Угол + 135, Желтый);

	// Отрисовка точки вращения для наглядности
	Рейлиб.НарисоватьКруг(200, 150, 5, Черный);
	Рейлиб.НарисоватьКруг(350, 150, 5, Черный);
	Рейлиб.НарисоватьКруг(500, 150, 5, Черный);
	Рейлиб.НарисоватьКруг(650, 150,  5, Черный);

	Рейлиб.НарисоватьТекст("DrawRectanglePro - rectagle ratation", 180, 250, 16, Черный);

	Рейлиб.ЗакончитьОтрисовку();

	Угол = Угол + 1;
	Если Угол >= 360 Тогда
		Угол = 0;
	КонецЕсли;

КонецЦикла;

Рейлиб.ЗакрытьОкно();
