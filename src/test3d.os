КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;


Рейлиб.ИнициализацияОкна("3D Демонстрация", 800, 600);

Белый = Рейлиб.НовыйЦвет(255,255,255,255);
Черный = Рейлиб.НовыйЦвет(0,0,0,255);
Красный = Рейлиб.НовыйЦвет(200,0,0,255);
Зеленый = Рейлиб.НовыйЦвет(0,200,0,255);
Синий = Рейлиб.НовыйЦвет(0,0,200,255);
Желтый = Рейлиб.НовыйЦвет(200,200,0,255);

// Камера3D: позиция, цель, вверх, поле зрения, проекция
ПозицияКамеры = Рейлиб.НовыйВектор3(5, 5, 5);
ЦельКамеры = Рейлиб.НовыйВектор3(0, 0, 0);
ВерхКамеры = Рейлиб.НовыйВектор3(0, 1, 0);
ПолеЗрения = 45;
Проекция = 0; // 0 = Перспективная, 1 = Ортографическая
Камера = Рейлиб.НоваяКамера3D(ПозицияКамеры, ЦельКамеры, ВерхКамеры, ПолеЗрения, Проекция);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

	Рейлиб.НачатьОтрисовку();
	Рейлиб.ОчиститьФон(Белый);
	
	// 3D режим
	Рейлиб.НачатьРежим3D(Камера);
	
	// Нарисовать куб в центре
	ПозицияКуба = Рейлиб.НовыйВектор3(0, 0, 0);
	Рейлиб.НарисоватьКуб(ПозицияКуба, 2, 2, 2, Красный);
	
	// Нарисовать каркасные кубы вокруг
	ПозицияКуба2 = Рейлиб.НовыйВектор3(-3, 0, 0);
	Рейлиб.НарисоватьКубЛиния(ПозицияКуба2, 1.5, 1.5, 1.5, Зеленый);
	
	ПозицияКуба3 = Рейлиб.НовыйВектор3(3, 0, 0);
	Рейлиб.НарисоватьКубЛиния(ПозицияКуба3, 1.5, 1.5, 1.5, Синий);
	
	ПозицияКуба4 = Рейлиб.НовыйВектор3(0, 0, -3);
	Рейлиб.НарисоватьКубЛиния(ПозицияКуба4, 1, 1, 1, Желтый);
	
	Рейлиб.ЗакончитьРежим3D();
	
	// 2D текст поверх 3D сцены
	Рейлиб.НарисоватьТекст("3D кубы (красный - заполненный, остальные - каркас)", 10, 10, 20, Черный);
	
	Приостановить(500);
	Рейлиб.ЗакончитьОтрисовку();

КонецЦикла;

Рейлиб.ЗакрытьОкно();
