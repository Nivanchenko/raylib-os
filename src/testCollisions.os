КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

// Проверяем обе ветки без окна: коллизии не требуют графического контекста.
Прямоугольник = Рейлиб.НовыйПрямоугольник(40, 40, 100, 80);
Если Не Рейлиб.ПересекаютсяПрямоугольники(Прямоугольник, Рейлиб.НовыйПрямоугольник(100, 80, 100, 80))
    Или Рейлиб.ПересекаютсяПрямоугольники(Прямоугольник, Рейлиб.НовыйПрямоугольник(300, 200, 40, 40)) Тогда
    ВызватьИсключение "Неверная коллизия прямоугольников";
КонецЕсли;
Центр = Рейлиб.НовыйВектор(90, 80);
Если Не Рейлиб.ПересекаютсяКруги(Центр, 30, Рейлиб.НовыйВектор(120, 80), 20)
    Или Рейлиб.ПересекаютсяКруги(Центр, 30, Рейлиб.НовыйВектор(250, 80), 20) Тогда
    ВызватьИсключение "Неверная коллизия кругов";
КонецЕсли;

Рейлиб.ИнициализацияОкна("2D Collisions", 480, 320);
Рейлиб.УстановитьЧастотуКадров(60);
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(220, 50, 50, 255);
Синий = Рейлиб.НовыйЦвет(50, 90, 220, 255);
НеподвижныйПрямоугольник = Рейлиб.НовыйПрямоугольник(50, 40, 140, 80);
НеподвижныйКруг = Рейлиб.НовыйВектор(110, 225);
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 3 Цикл
    Курсор = Рейлиб.ПозицияМыши();
    ПодвижныйПрямоугольник = Рейлиб.НовыйПрямоугольник(Рейлиб.ВекторX(Курсор), Рейлиб.ВекторY(Курсор), 90, 60);
    Если Рейлиб.ПересекаютсяПрямоугольники(НеподвижныйПрямоугольник, ПодвижныйПрямоугольник) Тогда
        ЦветПрямоугольника = Красный;
    Иначе
        ЦветПрямоугольника = Синий;
    КонецЕсли;
    Если Рейлиб.ПересекаютсяКруги(НеподвижныйКруг, 40, Курсор, 28) Тогда
        ЦветКруга = Красный;
    Иначе
        ЦветКруга = Синий;
    КонецЕсли;

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьПрямоугольник(50, 40, 140, 80, ЦветПрямоугольника);
    Рейлиб.НарисоватьПрямоугольникЛиния(Рейлиб.ВекторX(Курсор), Рейлиб.ВекторY(Курсор), 90, 60, ЦветПрямоугольника);
    Рейлиб.НарисоватьКруг(110, 225, 40, ЦветКруга);
    Рейлиб.НарисоватьКругЛиния(Рейлиб.ВекторX(Курсор), Рейлиб.ВекторY(Курсор), 28, ЦветКруга);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;
Рейлиб.ЗакрытьОкно();
