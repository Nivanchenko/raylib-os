КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Raylibos DrawTriangleFan Test", 800, 600);

Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Красный = Рейлиб.НовыйЦвет(200, 0, 0, 255);
Синий = Рейлиб.НовыйЦвет(0, 0, 200, 255);
Зеленый = Рейлиб.НовыйЦвет(0, 200, 0, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);

// Треугольный веер - точки расположены по кругу
ТочкиВеер = Новый Массив;
// Центральная точка (первая vertex - центр)
ТочкиВеер.Добавить(Рейлиб.НовыйВектор(400, 300));
// Точки по кругу
Для Сч = 0 По 12 Цикл
    Угол = Сч * 30 * 3.14159 / 180;
    X = 400 + Cos(Угол) * 150;
    Y = 300 + Sin(Угол) * 150;
    ТочкиВеер.Добавить(Рейлиб.НовыйВектор(X, Y));
КонецЦикла;

// Второй веер - меньшего размера
ТочкиВеер2 = Новый Массив;
ТочкиВеер2.Добавить(Рейлиб.НовыйВектор(200, 300));
Для Сч = 0 По 8 Цикл
    Угол = Сч * 45 * 3.14159 / 180;
    X = 200 + Cos(Угол) * 80;
    Y = 300 + Sin(Угол) * 80;
    ТочкиВеер2.Добавить(Рейлиб.НовыйВектор(X, Y));
КонецЦикла;

Рейлиб.УстановитьЧастотуКадров(60);

Пока Не Рейлиб.ОкноДолжноЗакрыться() Цикл

	Рейлиб.НачатьОтрисовку();

	Рейлиб.ОчиститьФон(Белый);

	// Отрисовка треугольного веера
	Рейлиб.НарисоватьТреугольникВеер(ТочкиВеер, Красный);
	Рейлиб.НарисоватьТреугольникВеер(ТочкиВеер2, Синий);

	// Подписи
	Рейлиб.НарисоватьТекст("DrawTriangleFan - triangle fan from center point", 200, 20, 16, Черный);
	Рейлиб.НарисоватьТекст("First vertex is the center, others form the rim", 220, 45, 12, Черный);
	Рейлиб.НарисоватьТекст("Large fan (red)", 350, 480, 12, Красный);
	Рейлиб.НарисоватьТекст("Small fan (blue)", 150, 480, 12, Синий);

	Рейлиб.ПоказатьFPS();

	Рейлиб.ЗакончитьОтрисовку();

КонецЦикла;

Рейлиб.ЗакрытьОкно();
