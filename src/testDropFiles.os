КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Drop files here", 640, 240);
Рейлиб.УстановитьЧастотуКадров(60);
// Без перетаскивания получаем пустой Массив; его можно использовать после освобождения нативного списка.
ПустойСписок = Рейлиб.ПолучитьПеретащенныеФайлы();
Если ПустойСписок.Количество() <> 0 Тогда
    ВызватьИсключение "Ожидался пустой список файлов";
КонецЕсли;
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);
ПоследнийФайл = "Перетащите файл в окно";
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 10 Цикл
    Если Рейлиб.ФайлПеретащен() Тогда
        Файлы = Рейлиб.ПолучитьПеретащенныеФайлы();
        Для Каждого Путь Из Файлы Цикл
            ПоследнийФайл = Путь;
            Сообщить("Перетащен файл: " + Путь);
        КонецЦикла;
    КонецЕсли;
    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьТекст(ПоследнийФайл, 20, 100, 20, Черный);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;
Рейлиб.ЗакрытьОкно();
