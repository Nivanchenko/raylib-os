КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

// Запускать из корня репозитория: пути к resources/ относительны рабочему каталогу.
Изображение = Рейлиб.ЗагрузитьИзображение("resources/raylib_logo.png");
Если Не Рейлиб.ИзображениеГотово(Изображение) Тогда
    ВызватьИсключение "Не удалось загрузить PNG";
КонецЕсли;
Если Изображение.Ширина() <> 256 Или Изображение.Высота() <> 256 Тогда
    Рейлиб.ВыгрузитьИзображение(Изображение);
    ВызватьИсключение "Неверный размер изображения";
КонецЕсли;
Рейлиб.ВыгрузитьИзображение(Изображение);

Отсутствует = Рейлиб.ЗагрузитьИзображение("resources/no_such_image_for_test.png");
Если Рейлиб.ИзображениеГотово(Отсутствует) Тогда
    Рейлиб.ВыгрузитьИзображение(Отсутствует);
    ВызватьИсключение "Отсутствующий файл не должен загружаться";
КонецЕсли;
