КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Input Test", 800, 450);
Рейлиб.УстановитьЧастотуКадров(60);
Рейлиб.УстановитьКлавишуВыхода(256); // ESC
Рейлиб.УстановитьДоступныеЖесты(1); // TAP
Рейлиб.УстановитьСмещениеМыши(0, 0);
Рейлиб.УстановитьМасштабМыши(1, 1);
Рейлиб.УстановитьКурсорМыши(0); // курсор по умолчанию
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 5 Цикл
    Нажата = Рейлиб.КлавишаНажатаОдин(65); // A
    Отпущена = Рейлиб.КлавишаОтпущена(65);
    Удерживается = Рейлиб.КлавишаНажата(65);
    Повтор = Рейлиб.КлавишаПовторноНажата(65);
    НеНажата = Рейлиб.КлавишаНеНажата(65);
    КодКлавиши = Рейлиб.ПолучитьНажатуюКлавишу();
    КодСимвола = Рейлиб.ПолучитьВведенныйСимвол();

    КнопкаНажата = Рейлиб.КнопкаМышиНажата(0);
    КнопкаЗажата = Рейлиб.КнопкаМышиЗажата(0);
    КнопкаОтпущена = Рейлиб.КнопкаМышиОтпущена(0);
    КнопкаНеНажата = Рейлиб.КнопкаМышиНеНажата(0);
    X = Рейлиб.МышьX();
    Y = Рейлиб.МышьY();
    Смещение = Рейлиб.СмещениеМыши();
    Колесо = Рейлиб.КолесоМышиВектор();

    Если Рейлиб.ГеймпадДоступен(0) Тогда
        ИмяГеймпада = Рейлиб.ИмяГеймпада(0);
        КоличествоОсей = Рейлиб.КоличествоОсейГеймпада(0);
        КнопкаГеймпада = Рейлиб.ПоследняяКнопкаГеймпада();
        Если КоличествоОсей > 0 Тогда
            Ось = Рейлиб.ОсьГеймпада(0, 0);
        КонецЕсли;
    КонецЕсли;

    КоличествоКасаний = Рейлиб.КоличествоКасаний();
    КасаниеX = Рейлиб.КасаниеX();
    КасаниеY = Рейлиб.КасаниеY();
    Если КоличествоКасаний > 0 Тогда
        ПозицияКасания = Рейлиб.ПозицияКасания(0);
        ИдентификаторКасания = Рейлиб.ИдентификаторКасания(0);
    КонецЕсли;
    Жест = Рейлиб.ПоследнийЖест();
    Касание = Рейлиб.ЖестОбнаружен(1);
    ДлительностьУдержания = Рейлиб.ВремяУдержанияЖеста();
    ВекторПеретаскивания = Рейлиб.ВекторПеретаскиванияЖеста();
    УголПеретаскивания = Рейлиб.УголПеретаскиванияЖеста();
    ВекторМасштабирования = Рейлиб.ВекторМасштабированияЖеста();
    УголМасштабирования = Рейлиб.УголМасштабированияЖеста();

    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьТекст("A pressed: " + Нажата + ", down: " + Удерживается + ", released: " + Отпущена, 20, 20, 20, Черный);
    Рейлиб.НарисоватьТекст("A repeat: " + Повтор + ", up: " + НеНажата, 20, 50, 20, Черный);
    Рейлиб.НарисоватьТекст("Key: " + КодКлавиши + ", char: " + КодСимвола, 20, 80, 20, Черный);
    Рейлиб.НарисоватьТекст("Mouse: " + X + ", " + Y + ", delta X: " + Рейлиб.ВекторX(Смещение), 20, 110, 20, Черный);
    Рейлиб.НарисоватьТекст("Left button: " + КнопкаНажата + ", " + КнопкаЗажата + ", " + КнопкаОтпущена + ", " + КнопкаНеНажата, 20, 140, 20, Черный);
    Рейлиб.НарисоватьТекст("Wheel Y: " + Рейлиб.ВекторY(Колесо) + ", touches: " + КоличествоКасаний + ", gesture: " + Жест, 20, 170, 20, Черный);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Рейлиб.ЗакрытьОкно();
