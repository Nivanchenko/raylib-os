КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

Рейлиб.ИнициализацияОкна("Measure Text", 480, 240);
Рейлиб.УстановитьЧастотуКадров(60);
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);
Текст = "Centered text";
ШиринаТекста = Рейлиб.ИзмеритьТекст(Текст, 30);
Если ШиринаТекста <= 0 Или ШиринаТекста >= 480
    Или Рейлиб.ИзмеритьТекст("", 30) <> 0 Тогда
    ВызватьИсключение "Некорректная ширина текста";
КонецЕсли;
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 2 Цикл
    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьЛинию(240, 0, 240, 240, Черный);
    Рейлиб.НарисоватьТекст(Текст, Окр((480 - ШиринаТекста) / 2, 0), 105, 30, Черный);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;
Рейлиб.ЗакрытьОкно();
