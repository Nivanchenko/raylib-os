КаталогКомпоненты = ОбъединитьПути(ТекущийСценарий().Каталог, "raylibos/bin/Debug/net6.0/raylibos.dll");
ПодключитьВнешнююКомпоненту(КаталогКомпоненты);
Рейлиб = Новый Рейлиб;

// Запускайте из корня репозитория: путь к WAV отсчитывается от рабочего каталога.
Рейлиб.ИнициализацияОкна("Audio Test (SPACE to replay)", 480, 240);
Рейлиб.УстановитьЧастотуКадров(60);
Рейлиб.ИнициализироватьЗвук();
Если Не Рейлиб.ЗвуковоеУстройствоГотово() Тогда
    Рейлиб.ЗакрытьЗвуковоеУстройство();
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Аудиоустройство недоступно";
КонецЕсли;

Звук = Рейлиб.ЗагрузитьЗвук("resources/test_tone.wav");
Если Не Рейлиб.ЗвукГотов(Звук) Тогда
    Рейлиб.ЗакрытьЗвуковоеУстройство();
    Рейлиб.ЗакрытьОкно();
    ВызватьИсключение "Не удалось загрузить тестовый WAV";
КонецЕсли;
Рейлиб.ВоспроизвестиЗвук(Звук);
Белый = Рейлиб.НовыйЦвет(255, 255, 255, 255);
Черный = Рейлиб.НовыйЦвет(0, 0, 0, 255);
Начало = Рейлиб.ВремяРаботы();

Пока Не Рейлиб.ОкноДолжноЗакрыться() И Рейлиб.ВремяРаботы() - Начало < 3 Цикл
    Если Рейлиб.КлавишаНажатаОдин(32) Тогда // KEY_SPACE
        Рейлиб.ВоспроизвестиЗвук(Звук);
    КонецЕсли;
    Рейлиб.НачатьОтрисовку();
    Рейлиб.ОчиститьФон(Белый);
    Рейлиб.НарисоватьТекст("SPACE: replay test tone", 20, 95, 20, Черный);
    Рейлиб.ЗакончитьОтрисовку();
КонецЦикла;

Рейлиб.ВыгрузитьЗвук(Звук);
Рейлиб.ЗакрытьЗвуковоеУстройство();
Рейлиб.ЗакрытьОкно();
